doctype html
html
  head
    title Danh sách tài khoản - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm tài khoản...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 Danh sách tài khoản
          p Tách riêng danh sách đăng nhập khỏi danh sách hồ sơ nhân viên.

        .table-container
          table
            thead
              tr
                th Tên đăng nhập
                th Quyền
                th Nhân viên liên kết
                th Trạng thái mật khẩu
            tbody
              if accounts && accounts.length > 0
                each account in accounts
                  tr
                    td(style="font-weight: bold;")= account.username
                    td= account.role
                    td= account.linkedEmployeeName
                    td= account.passwordStatus
              else
                tr
                  td(colspan="4", style="text-align: center; padding: 20px;") Chưa có dữ liệu tài khoản

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });
