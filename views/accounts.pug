doctype html
html
  head
    title Danh sách tài khoản - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") Danh sách nhân viên

        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/departments") Phòng ban
            a.submenu-item(href="/positions") Chức vụ
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên

        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span #{user.role === 'admin' ? 'Quản lý lương' : 'Phiếu lương'}
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟


        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-award
              span Khen thưởng - Kỷ luật
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Khen thưởng
            a.submenu-item(href="#") Kỷ luật

        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon.rotate
          .submenu.show
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item.active(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm tài khoản...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 Danh sách tài khoản
          p Tách riêng danh sách đăng nhập khỏi danh sách hồ sơ nhân viên.

        .table-container
          table
            thead
              tr
                th Tên đăng nhập
                th Quyền
                th Nhân viên liên kết
                th Trạng thái mật khẩu
            tbody
              if accounts && accounts.length > 0
                each account in accounts
                  tr
                    td(style="font-weight: bold;")= account.username
                    td= account.role
                    td= account.linkedEmployeeName
                    td= account.passwordStatus
              else
                tr
                  td(colspan="4", style="text-align: center; padding: 20px;") Chưa có dữ liệu tài khoản

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });
