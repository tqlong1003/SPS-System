doctype html
html
  head
    title Thêm hợp đồng
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Chèn trực tiếp nội dung Sidebar
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      .sidebar-menu
        p.menu-label CHÍNH
        a.menu-item(href="/dashboard")
          i.fas.fa-th-large
          span Tổng quan
        p.menu-label NHÂN SỰ
        a.menu-item(href="/employees")
          i.fas.fa-users
          span Nhân viên
        a.menu-item(href="/departments")
          i.fas.fa-sitemap
          span Phòng ban
        a.menu-item(href="/positions")
          i.fas.fa-briefcase
          span Chức vụ
        a.menu-item.active(href="/contracts")
          i.fas.fa-file-contract
          span Hợp đồng
        // ... (phần còn lại của sidebar giống file trên)
      .sidebar-footer
        a.logout-btn(href="/logout")
          i.fas.fa-sign-out-alt
          span Đăng xuất

    main.main-content
      .form-container
        h2 Tạo hợp đồng mới
        form(action="/contracts/add", method="POST")
          label Số hợp đồng:
          input(type="text", name="contractNumber", required)
          
          label Ngày ký:
          input(type="date", name="signDate", required)
          
          label Loại hợp đồng:
          select(name="contractType")
            option(value="Thử việc") Thử việc
            option(value="Xác định thời hạn") Xác định thời hạn
            option(value="Không xác định thời hạn") Không xác định thời hạn
          
          label Thời hạn:
          input(type="text", name="duration", placeholder="VD: 1 năm, 6 tháng...")
          
          label Nhân viên:
          select(name="employeeId")
            each emp in employees
              option(value=emp._id)= emp.name
          
          button.save-btn(type="submit") Lưu hợp đồng