doctype html
html
  head
    title Thêm hợp đồng - SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          .submenu.show
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") Danh sách nhân viên
            a.submenu-item(href="#") Danh sách tài khoản

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon.rotate
          .submenu.show
            a.submenu-item(href="/departments") Phòng ban
            a.submenu-item(href="/positions") Chức vụ
            a.submenu-item.active(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟

        // --- QUẢN LÝ CÔNG TÁC ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-plane-departure
              span Quản lý công tác
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Danh sách công tác

        // --- KHEN THƯỞNG - KỶ LUẬT ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-award
              span Khen thưởng - Kỷ luật
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Khen thưởng
            a.submenu-item(href="#") Kỷ luật

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Thông tin tài khoản
            a.submenu-item(href="#") Danh sách tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="#") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .center-wrapper
        .card-form
          .card-header
            i.fas.fa-plus-circle
            h2 Tạo hợp đồng mới
          form(action="/contracts/add", method="POST")
            .form-group
              label Số hợp đồng:
              input(type="text", name="contractNumber", required)
            
            .form-group
              label Ngày ký:
              input(type="date", name="signDate", required)
            
            .form-group
              label Loại hợp đồng:
              select(name="contractType" style="width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #e5e7eb;")
                option(value="Thử việc") Thử việc
                option(value="Xác định thời hạn") Xác định thời hạn
                option(value="Không xác định thời hạn") Không xác định thời hạn
            
            .form-group
              label Thời hạn:
              input(type="text", name="duration", placeholder="VD: 1 năm, 6 tháng...")
            
            .form-actions
              button.btn-save(type="submit") Tạo hợp đồng

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          this.closest('.menu-group').querySelector('.submenu').classList.toggle('show');
          this.querySelector('.toggle-icon').classList.toggle('rotate');
        });
      });