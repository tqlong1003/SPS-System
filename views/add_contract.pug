doctype html
html
  head
    title Thêm hợp đồng - SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi



        

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .center-wrapper
        .card-form
          .card-header
            i.fas.fa-plus-circle
            h2 Tạo hợp đồng mới
          form(action="/contracts/add", method="POST")

            //- Thêm đoạn này vào trong form sau các trường thông tin khác
            .form-group
              label Nhân viên:
              select(name="employeeId" style="width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #e5e7eb;" required)
                option(value="") -- Chọn nhân viên --
                each emp in employees
                  option(value=emp._id)= emp.name
            .form-group
              label Số hợp đồng:
              input(type="text", name="contractNumber", required)
            
            .form-group
              label Ngày ký:
              input(type="date", name="signDate", required)
            
            .form-group
              label Loại hợp đồng:
              select(name="contractType" style="width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #e5e7eb;")
                option(value="Thử việc") Thử việc
                option(value="Xác định thời hạn") Xác định thời hạn
                option(value="Không xác định thời hạn") Không xác định thời hạn
            
            .form-group
              label Thời hạn:
              input(type="text", name="duration", placeholder="VD: 1 năm, 6 tháng...")
            
            .form-actions
              button.btn-save(type="submit") Tạo hợp đồng

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          this.closest('.menu-group').querySelector('.submenu').classList.toggle('show');
          this.querySelector('.toggle-icon').classList.toggle('rotate');
        });
      });