doctype html
html
  head
    title Thêm hợp đồng - SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug


    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .center-wrapper
        .card-form
          .card-header
            i.fas.fa-plus-circle
            h2 Tạo hợp đồng mới
          form(action="/contracts/add", method="POST")

            //- Thêm đoạn này vào trong form sau các trường thông tin khác
            .form-group
              label Nhân viên:
              select(name="employeeId" style="width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #e5e7eb;" required)
                option(value="") -- Chọn nhân viên --
                each emp in employees
                  option(value=emp._id)= emp.name
            .form-group
              label Số hợp đồng:
              input(type="text", name="contractNumber", required)
            
            .form-group
              label Ngày ký:
              input(type="date", name="signDate", required)
            
            .form-group
              label Loại hợp đồng:
              select(name="contractType" style="width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #e5e7eb;")
                option(value="Thử việc") Thử việc
                option(value="Xác định thời hạn") Xác định thời hạn
                option(value="Không xác định thời hạn") Không xác định thời hạn
            
            .form-group
              label Thời hạn:
              input(type="text", name="duration", placeholder="VD: 1 năm, 6 tháng...")
            
            .form-actions
              button.btn-save(type="submit") Tạo hợp đồng

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          this.closest('.menu-group').querySelector('.submenu').classList.toggle('show');
          this.querySelector('.toggle-icon').classList.toggle('rotate');
        });
      });