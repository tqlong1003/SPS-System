doctype html
html
  head
    title Ban hành quyết định mới - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    style.
      .recipient-section {
        background: #f8fafc;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 4px;
      }
      .recipient-options {
        display: flex;
        gap: 16px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }
      .recipient-option {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        font-weight: 500;
        color: #374151;
      }
      .recipient-option input { width: auto; margin: 0; }
      .employee-checklist {
        display: none;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px;
        margin-top: 10px;
        max-height: 260px;
        overflow-y: auto;
        padding: 4px;
      }
      .employee-checklist.show { display: grid; }
      .employee-check-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: white;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        transition: border-color 0.2s;
        font-size: 0.9rem;
      }
      .employee-check-item:hover { border-color: #6366f1; }
      .employee-check-item input { width: auto; margin: 0; cursor: pointer; }
      .employee-check-item.selected { border-color: #6366f1; background: #eef2ff; }
      .search-employee {
        width: 100%;
        padding: 8px 12px;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.9rem;
        margin-bottom: 10px;
        display: none;
        box-sizing: border-box;
      }
      .search-employee.show { display: block; }
      .select-all-row {
        display: none;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #6366f1;
        cursor: pointer;
      }
      .select-all-row.show { display: flex; }
      .select-all-row input { width: auto; margin: 0; }
  body.dashboard-body
    include sidebar.pug

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 📝 Ban hành quyết định mới
          p Quyết định chỉ hiển thị với nhân viên được chỉ định

        .center-wrapper
          .card-form
            .card-header
              i.fas.fa-file-alt
              h2 Nội dung quyết định

            if error
              .alert-error= error

            form(method="POST" action="/decisions/add" enctype="multipart/form-data")
              .form-group
                label Tiêu đề quyết định
                input(type="text" name="title" placeholder="VD: Quyết định bổ nhiệm Trưởng phòng Kỹ thuật" required)

              .form-group
                label Nội dung chi tiết
                textarea(name="content" rows="6" placeholder="Nhập nội dung quyết định..." required style="width: 100%; padding: 12px 15px; border: 1.5px solid #e5e7eb; border-radius: 10px; font-size: 1rem; font-family: inherit; resize: vertical;")

              .form-group
                label Văn bản đính kèm (PDF, ảnh quyết định... nếu có)
                input(type="file" name="attachment" style="background: white; border: 1.5px solid #e5e7eb; padding: 10px 15px;")

              //- Phần chọn nhân viên nhận quyết định
              .form-group
                label
                  i.fas.fa-users(style="margin-right: 6px; color: #6366f1;")
                  | Gửi quyết định đến
                .recipient-section
                  .recipient-options
                    label.recipient-option
                      input(type="radio" name="recipientType" value="specific" id="specificRadio" checked)
                      | Chọn nhân viên cụ thể
                    label.recipient-option
                      input(type="radio" name="recipientType" value="all" id="allRadio")
                      | Gửi cho tất cả nhân viên

                  input#searchEmployee.search-employee.show(type="text" placeholder="🔍 Tìm tên hoặc mã nhân viên...")

                  label.select-all-row.show
                    input(type="checkbox" id="selectAllCheckbox")
                    | Chọn tất cả

                  .employee-checklist#employeeChecklist.show
                    each emp in employees
                      label.employee-check-item(data-name=emp.name.toLowerCase() data-code=(emp.employeeCode || '').toLowerCase())
                        input(type="checkbox" name="recipients" value=String(emp._id))
                        span
                          strong= emp.name
                          br
                          small(style="color: #6b7280;")= (emp.employeeCode ? emp.employeeCode + ' • ' : '') + (emp.department || '')

              .form-group(style="display: flex; align-items: center; gap: 10px;")
                input(type="checkbox" name="pinned" id="pinned" style="width: auto; margin: 0;")
                label(for="pinned" style="margin: 0; cursor: pointer;") Ghim quan trọng lên đầu danh sách

              .form-actions
                button.btn-save(type="submit")
                  i.fas.fa-paper-plane
                  |  Ban hành quyết định
                a.btn-cancel(href="/decisions") Hủy bỏ

    script.
      // Toggle submenu sidebar
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if (icon) icon.classList.remove('rotate');
            }
          });
          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });

      // Toggle hiển thị danh sách chọn nhân viên
      document.querySelectorAll('input[name="recipientType"]').forEach(radio => {
        radio.addEventListener('change', function() {
          const checklist = document.getElementById('employeeChecklist');
          const searchInput = document.getElementById('searchEmployee');
          const selectAllRow = document.querySelector('.select-all-row');
          if (this.value === 'specific') {
            checklist.classList.add('show');
            searchInput.classList.add('show');
            selectAllRow.classList.add('show');
          } else {
            checklist.classList.remove('show');
            searchInput.classList.remove('show');
            selectAllRow.classList.remove('show');
            // Bỏ chọn hết khi chọn "tất cả"
            document.querySelectorAll('#employeeChecklist input[type="checkbox"]').forEach(cb => cb.checked = false);
          }
        });
      });

      // Tìm kiếm nhân viên trong checklist
      document.getElementById('searchEmployee').addEventListener('input', function() {
        const keyword = this.value.toLowerCase();
        document.querySelectorAll('.employee-check-item').forEach(item => {
          const name = item.dataset.name || '';
          const code = item.dataset.code || '';
          item.style.display = (name.includes(keyword) || code.includes(keyword)) ? '' : 'none';
        });
      });

      // Chọn / bỏ chọn tất cả
      document.getElementById('selectAllCheckbox').addEventListener('change', function() {
        document.querySelectorAll('#employeeChecklist input[type="checkbox"]').forEach(cb => {
          cb.checked = this.checked;
          cb.closest('.employee-check-item').classList.toggle('selected', this.checked);
        });
      });

      // Highlight item được chọn
      document.querySelectorAll('.employee-check-item input[type="checkbox"]').forEach(cb => {
        cb.addEventListener('change', function() {
          this.closest('.employee-check-item').classList.toggle('selected', this.checked);
        });
      });
