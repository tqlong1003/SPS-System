doctype html
html
  head
    title Thêm phòng ban - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug


    // Khu vực nội dung bên phải
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        
        if user
          .user-info
            span.welcome Xin chào, 
              strong #{user.username}
            .avatar #{user.username.charAt(0).toUpperCase()}

      .center-wrapper
        .card-form
          .card-header
            i.fas.fa-plus-circle
            h2 Thêm phòng ban mới
          
          form(method="POST", action="/departments/add")
            .form-group
              label Tên phòng ban
              input(type="text", name="name", placeholder="Ví dụ: Phòng Kỹ thuật", required)
            .form-group
              label Mô tả
              input(type="text", name="description", placeholder="Nhập mô tả ngắn gọn")
            .form-group
              label Trưởng phòng
              input(type="text", name="manager", placeholder="Họ và tên trưởng phòng")
            .form-group
              label Ngày thành lập
              input(type="date", name="establishmentDate")
            .form-actions
              button.btn-save(type="submit") Lưu lại
              a.btn-back(href="/departments") 
                i.fas.fa-arrow-left
                span  Quay lại

    // Script đóng mở menu
    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });