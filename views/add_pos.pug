doctype html
html
  head
    title Thêm chức vụ - SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi



        

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .center-wrapper
          .card-form
            .card-header
              i.fas.fa-plus-circle
              h2(style="margin:0") Thêm chức vụ mới
            
            form(method="POST" action="/positions/add")
              .form-group
                label Mã chức vụ
                input(name="posCode", placeholder="VD: GD, TP, NV...", required)
              
              .form-group
                label Tên chức vụ
                input(name="posName", placeholder="VD: Giám đốc, Trưởng phòng...", required)
              
              .form-actions
                a.btn-back(href="/positions" style="margin-right: 10px; text-decoration: none; padding: 10px 15px; background: #6c757d; color: white; border-radius: 4px; display: inline-block;") 
                  i.fas.fa-arrow-left(style="margin-right: 5px;")
                  | Quay lại
                button.btn-save(type="submit") Lưu chức vụ

    // Script xử lý đóng/mở mượt mà cho Dropdown Menu
    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              sub.closest('.menu-group').querySelector('.toggle-icon').classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });