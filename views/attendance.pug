doctype html
html
  head
    title Quản lý chấm công - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug

    // Khu vực nội dung bên phải

    main.main-content
      header.topbar
        if user.role === 'admin'
          form.search-bar(method="GET" action="/attendance")
            if selectedAttendancePerson
              input(type="hidden" name="employeeId" value=selectedAttendancePerson.employeeId)
            i.fas.fa-search
            input(type="text" name="keyword" value=searchKeyword placeholder="Tìm kiếm theo tên nhân viên...")
            button.btn-add(type="submit") Tìm kiếm
            if searchKeyword
              a.btn-cancel(href=selectedAttendancePerson ? `/attendance?employeeId=${selectedAttendancePerson.employeeId}` : '/attendance' style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none;") Xóa
        else
          .search-bar
            i.fas.fa-search
            input(type="text" placeholder="Tìm kiếm..." readonly)
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 📅 Quản lý chấm công
          p Check-in theo vị trí GPS tại công ty và theo dõi tình trạng đi làm của nhân sự

        if error
          div(style="margin-bottom: 16px; padding: 14px 16px; border-radius: 10px; background: #fee2e2; color: #b91c1c; font-weight: 600;")= error

        if success
          div(style="margin-bottom: 16px; padding: 14px 16px; border-radius: 10px; background: #dcfce7; color: #166534; font-weight: 600;")= success

        if employee
          .card-form(style="margin-bottom: 20px;")
            .card-header
              i.fas.fa-map-marker-alt
              h2 Check-in tại công ty

            if attendanceSettings.isConfigured
              p(style="margin-bottom: 12px; color: #475569;")
                | Vị trí công ty: 
                strong #{attendanceSettings.companyName}
                |  | Bán kính hợp lệ: 
                strong #{attendanceSettings.allowedRadiusMeters} m
            else
              p(style="margin-bottom: 12px; color: #b91c1c; font-weight: 600;")
                | Hệ thống chưa cấu hình tọa độ công ty. Cập nhật COMPANY_LATITUDE và COMPANY_LONGITUDE trong server trước khi check-in.

            if todayAttendance
              div(style="margin-bottom: 16px; padding: 12px 14px; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0;")
                p(style="margin: 0 0 6px;")
                  strong Hôm nay: 
                  | #{todayAttendance.workDate}
                p(style="margin: 0 0 6px;")
                  strong Check-in: 
                  | #{todayAttendance.checkInDisplay}
                p(style="margin: 0 0 6px;")
                  strong Check-out: 
                  | #{todayAttendance.checkOutDisplay}
                p(style="margin: 0;")
                  strong Khoảng cách xác thực: 
                  | #{todayAttendance.distanceDisplay}
                if todayAttendance.checkInPhoto
                  p(style="margin: 10px 0 0;")
                    strong Ảnh check-in:
                  img(src=todayAttendance.checkInPhoto, alt="Ảnh check-in", style="margin-top: 8px; width: 180px; border-radius: 10px; border: 1px solid #e2e8f0;")

            form#checkinForm(action="/attendance/checkin", method="POST")
              input(type="hidden", name="latitude", id="latitude")
              input(type="hidden", name="longitude", id="longitude")
              input(type="hidden", name="accuracy", id="accuracy")
              input(type="hidden", name="photoData", id="photoData")
              .form-group(style="margin-bottom: 12px;")
                label Ảnh check-in
                p(style="margin: 6px 0 12px; color: #64748b;") Dùng camera thiết bị để chụp ảnh trước khi gửi chấm công.
                video#cameraPreview(autoplay playsinline style="width: 100%; max-width: 480px; border-radius: 14px; background: #0f172a; display: none;")
                img#capturedPreview(alt="Ảnh vừa chụp" style="width: 100%; max-width: 480px; border-radius: 14px; display: none; margin-top: 10px; border: 1px solid #e2e8f0;")
                canvas#captureCanvas(style="display: none;")
              .form-actions(style="display: flex; gap: 12px; flex-wrap: wrap;")
                button.btn-cancel(type="button", id="openCameraButton", disabled=(todayAttendance && todayAttendance.checkInAt))
                  i.fas.fa-camera
                  |  Mở camera
                button.btn-edit(type="button", id="capturePhotoButton", disabled=(todayAttendance && todayAttendance.checkInAt))
                  i.fas.fa-camera-retro
                  |  Chụp ảnh
                button.btn-cancel(type="button", id="retakePhotoButton", style="display: none;", disabled=(todayAttendance && todayAttendance.checkInAt))
                  i.fas.fa-rotate-left
                  |  Chụp lại
                button.btn-save(type="button", id="checkinButton", disabled=(todayAttendance && todayAttendance.checkInAt))
                  i.fas.fa-location-crosshairs
                  |  Chụp ảnh và check-in

            if todayAttendance && todayAttendance.checkInAt && !todayAttendance.checkOutAt
              form(action="/attendance/checkout", method="POST", style="margin-top: 12px;")
                .form-actions
                  button.btn-cancel(type="submit")
                    i.fas.fa-right-from-bracket
                    |  Check-out

            p#gpsStatus(style="margin-top: 12px; color: #475569; font-weight: 500;")
              if todayAttendance && todayAttendance.checkInAt
                | Bạn đã check-in hôm nay. Nếu chưa kết thúc ngày làm việc, có thể bấm check-out.
              else
                | Mở camera, chụp ảnh rồi bấm check-in. Hệ thống sẽ gửi kèm GPS hiện tại để xác thực vị trí.

            p#gpsAccuracyStatus(style="margin-top: 8px; color: #64748b; font-size: 0.95rem;")
              if todayAttendance && todayAttendance.location && todayAttendance.location.accuracy
                | Độ chính xác GPS lần check-in gần nhất: #{Math.round(todayAttendance.location.accuracy)} m
              else
                | Độ chính xác GPS sẽ hiển thị sau khi thiết bị lấy được vị trí hiện tại.

        else
          div(style="margin-bottom: 16px; padding: 14px 16px; border-radius: 10px; background: #fff7ed; color: #9a3412; font-weight: 600;")
            | Tài khoản này chưa được liên kết với hồ sơ nhân viên, nên chưa thể check-in/check-out tự động.

        if user.role === 'admin'
          .attendance-toolbar
            .attendance-filter-card
              .attendance-filter-header
                i.fas.fa-calendar-alt
                span Lọc chấm công theo tháng

              form.attendance-filter-form(method="GET" action="/attendance")
                if selectedAttendancePerson
                  input(type="hidden" name="employeeId" value=selectedAttendancePerson.employeeId)
                if searchKeyword
                  input(type="hidden" name="keyword" value=searchKeyword)
                .attendance-filter-field
                  label(for="attendanceMonth") Chọn tháng xem chấm công
                  input#attendanceMonth(type="month" name="month" value=selectedMonth)
                .attendance-filter-actions
                  button.btn-add(type="submit")
                    i.fas.fa-filter
                    | Lọc tháng
                  if selectedMonth
                    a.btn-cancel(href=selectedAttendancePerson ? `/attendance?employeeId=${selectedAttendancePerson.employeeId}${searchKeyword ? `&keyword=${encodeURIComponent(searchKeyword)}` : ''}` : searchKeyword ? `/attendance?keyword=${encodeURIComponent(searchKeyword)}` : '/attendance')
                      i.fas.fa-undo
                      | Xóa
                  a.btn.attendance-add-btn(href="/attendance/add")
                    i.fas.fa-plus
                    | Thêm chấm công thủ công

        if user.role === 'admin' && attendancePeople && attendancePeople.length > 0
          .card-form(style="max-width: 100%; margin-bottom: 20px; padding: 24px;")
            .card-header(style="margin-bottom: 18px;")
              i.fas.fa-users
              h2 Danh sách nhân viên đã chấm công
            div(style="display: flex; flex-wrap: wrap; gap: 12px;")
              each person in attendancePeople
                a(href=`/attendance?employeeId=${person.employeeId}${searchKeyword ? `&keyword=${encodeURIComponent(searchKeyword)}` : ''}${selectedMonth ? `&month=${selectedMonth}` : ''}` style=`display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 999px; text-decoration: none; font-weight: 600; border: 1px solid #cbd5e1; background: ${selectedAttendancePerson && selectedAttendancePerson.employeeId === person.employeeId ? 'var(--primary)' : '#ffffff'}; color: ${selectedAttendancePerson && selectedAttendancePerson.employeeId === person.employeeId ? '#ffffff' : '#334155'}; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);`)
                  i.fas.fa-user-check
                  span #{person.employeeName}
                  span(style=`padding: 2px 8px; border-radius: 999px; font-size: 0.85rem; background: ${selectedAttendancePerson && selectedAttendancePerson.employeeId === person.employeeId ? 'rgba(255,255,255,0.2)' : '#eef2ff'}; color: inherit;`) #{person.totalDays} ngày
              if selectedAttendancePerson
                a(href=`/attendance${searchKeyword || selectedMonth ? '?' : ''}${searchKeyword ? `keyword=${encodeURIComponent(searchKeyword)}` : ''}${searchKeyword && selectedMonth ? '&' : ''}${selectedMonth ? `month=${selectedMonth}` : ''}` style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 999px; text-decoration: none; font-weight: 600; border: 1px dashed #94a3b8; color: #475569; background: #f8fafc;")
                  i.fas.fa-rotate-left
                  span Xem tất cả

        if selectedAttendancePerson
          div(style="margin-bottom: 16px; padding: 14px 16px; border-radius: 10px; background: #eef2ff; color: #3730a3; font-weight: 600;")
            | Đang hiển thị lịch sử chấm công theo ngày của nhân viên: #{selectedAttendancePerson.employeeName}

        if selectedMonth
          div(style="margin-bottom: 16px; padding: 14px 16px; border-radius: 10px; background: #eff6ff; color: #1d4ed8; font-weight: 600;")
            | Đang lọc chấm công theo tháng: #{selectedMonth}

        .table-container
          table
            thead
              tr
                th Nhân viên
                th Ngày
                th Check-in
                th Check-out
                th Trạng thái
                th Khoảng cách
                th Tăng ca
                if user.role === 'admin'
                  th Hành động
            tbody
              if attendance && attendance.length > 0
                each record in attendance
                  tr
                    td
                      if user.role === 'admin'
                        a(href=`/attendance?employeeId=${record.employeeId}${searchKeyword ? `&keyword=${encodeURIComponent(searchKeyword)}` : ''}${selectedMonth ? `&month=${selectedMonth}` : ''}` style="font-weight: 600; color: var(--primary); text-decoration: none;")= record.employeeName
                      else
                        = record.employeeName
                    td= record.workDate
                    td= record.checkInDisplay
                    td= record.checkOutDisplay
                    td
                      case record.status
                        when 'present'
                          | Có mặt
                        when 'absent'
                          | Vắng mặt
                        when 'leave'
                          | Xin nghỉ
                        default
                          = record.status
                    td= record.distanceDisplay
                    td= record.overtime ? 'Có' : 'Không'
                    if user.role === 'admin'
                      td
                        a.btn-edit(href=`/attendance/edit/${record._id}`) Sửa
                        a.btn-delete(href=`/attendance/delete/${record._id}` onclick="return confirm('Bạn có chắc chắn muốn xóa dữ liệu chấm công này không?')" style="margin-left: 5px;") Xóa
              else
                tr
                  td(colspan=user.role === 'admin' ? "8" : "7", style="text-align: center; padding: 20px;") Chưa có dữ liệu

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });

      let cameraStream = null;
      const checkinButton = document.getElementById('checkinButton');
      const checkinForm = document.getElementById('checkinForm');
      const gpsStatus = document.getElementById('gpsStatus');
      const openCameraButton = document.getElementById('openCameraButton');
      const capturePhotoButton = document.getElementById('capturePhotoButton');
      const retakePhotoButton = document.getElementById('retakePhotoButton');
      const gpsAccuracyStatus = document.getElementById('gpsAccuracyStatus');
      const cameraPreview = document.getElementById('cameraPreview');
      const capturedPreview = document.getElementById('capturedPreview');
      const captureCanvas = document.getElementById('captureCanvas');
      const photoData = document.getElementById('photoData');
      const companyConfigured = !{JSON.stringify(attendanceSettings.isConfigured)};

      async function openCamera() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          if (gpsStatus) {
            gpsStatus.textContent = 'Trình duyệt này không hỗ trợ camera.';
          }
          return;
        }

        try {
          cameraStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'user' },
            audio: false
          });

          if (cameraPreview) {
            cameraPreview.srcObject = cameraStream;
            cameraPreview.style.display = 'block';
          }
          if (capturedPreview) {
            capturedPreview.style.display = 'none';
          }
          if (retakePhotoButton) {
            retakePhotoButton.style.display = 'none';
          }
          if (gpsStatus) {
            gpsStatus.textContent = 'Camera đã sẵn sàng. Hãy bấm chụp ảnh.';
          }
        } catch (error) {
          if (gpsStatus) {
            gpsStatus.textContent = 'Không thể mở camera. Hãy kiểm tra quyền truy cập camera trên trình duyệt.';
          }
        }
      }

      function stopCamera() {
        if (cameraStream) {
          cameraStream.getTracks().forEach(track => track.stop());
          cameraStream = null;
        }
      }

      if (checkinButton && checkinForm && gpsStatus) {
        if (openCameraButton) {
          openCameraButton.addEventListener('click', () => {
            openCamera();
          });
        }

        if (capturePhotoButton) {
          capturePhotoButton.addEventListener('click', () => {
            if (!cameraPreview || !cameraPreview.srcObject) {
              gpsStatus.textContent = 'Bạn cần mở camera trước khi chụp ảnh.';
              return;
            }

            captureCanvas.width = cameraPreview.videoWidth || 640;
            captureCanvas.height = cameraPreview.videoHeight || 480;
            const context = captureCanvas.getContext('2d');
            context.drawImage(cameraPreview, 0, 0, captureCanvas.width, captureCanvas.height);

            const snapshot = captureCanvas.toDataURL('image/jpeg', 0.92);
            photoData.value = snapshot;
            capturedPreview.src = snapshot;
            capturedPreview.style.display = 'block';
            if (retakePhotoButton) {
              retakePhotoButton.style.display = 'inline-flex';
            }
            gpsStatus.textContent = 'Đã chụp ảnh check-in. Bây giờ bạn có thể bấm check-in.';
            stopCamera();
            cameraPreview.style.display = 'none';
          });
        }

        if (retakePhotoButton) {
          retakePhotoButton.addEventListener('click', () => {
            photoData.value = '';
            capturedPreview.src = '';
            capturedPreview.style.display = 'none';
            openCamera();
          });
        }

        checkinButton.addEventListener('click', () => {
          if (!photoData.value) {
            gpsStatus.textContent = 'Bạn cần chụp ảnh trước khi check-in.';
            return;
          }

          if (!companyConfigured) {
            gpsStatus.textContent = 'Đã chụp ảnh nhưng hệ thống chưa cấu hình tọa độ công ty, nên chưa thể xác thực GPS để check-in.';
            return;
          }

          if (!navigator.geolocation) {
            gpsStatus.textContent = 'Trình duyệt này không hỗ trợ định vị GPS.';
            return;
          }

          gpsStatus.textContent = 'Đang lấy vị trí hiện tại, vui lòng chờ vài giây...';
          checkinButton.disabled = true;

          navigator.geolocation.getCurrentPosition(
            position => {
              document.getElementById('latitude').value = position.coords.latitude;
              document.getElementById('longitude').value = position.coords.longitude;
              document.getElementById('accuracy').value = position.coords.accuracy || '';
              if (gpsAccuracyStatus) {
                const roundedAccuracy = Math.round(position.coords.accuracy || 0);
                gpsAccuracyStatus.textContent = roundedAccuracy > 0
                  ? `Độ chính xác GPS hiện tại: ${roundedAccuracy} m.`
                  : 'Thiết bị đã trả về vị trí nhưng không có chỉ số accuracy rõ ràng.';
              }
              gpsStatus.textContent = 'Đã lấy được GPS, đang gửi check-in...';
              checkinForm.submit();
            },
            error => {
              const messages = {
                1: 'Bạn đã từ chối quyền truy cập vị trí.',
                2: 'Không thể xác định vị trí hiện tại.',
                3: 'Thiết bị lấy GPS quá lâu, hãy thử lại.'
              };

              gpsStatus.textContent = messages[error.code] || 'Không thể lấy GPS từ thiết bị.';
              if (gpsAccuracyStatus) {
                gpsAccuracyStatus.textContent = 'Chưa lấy được GPS nên chưa có chỉ số độ chính xác.';
              }
              checkinButton.disabled = false;
            },
            {
              enableHighAccuracy: true,
              timeout: 10000,
              maximumAge: 0
            }
          );
        });

        window.addEventListener('beforeunload', () => {
          stopCamera();
        });
      }