doctype html
html
  head
    title Đổi mật khẩu - PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    include sidebar.pug
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào,
            strong= user.name || user.username
          .avatar= (user.name || user.username).charAt(0).toUpperCase()

      .content-wrapper
        .card-form
          .card-header
            i.fas.fa-key
            h2 Đổi mật khẩu

          if error
            p.alert-error
              i.fas.fa-exclamation-circle(style="margin-right: 5px")
              | #{error}
          if success
            p.alert-success= success

          form(method="POST" action="/change-password")
            .form-group
              label Mật khẩu hiện tại
              input(type="password" name="currentPassword" required)
            .form-group
              label Mật khẩu mới
              input(type="password" name="newPassword" required minlength="6")
            .form-group
              label Xác nhận mật khẩu mới
              input(type="password" name="confirmPassword" required minlength="6")

            .form-actions
              button.btn-save(type="submit") Đổi mật khẩu
              a.btn-cancel(href="/profile") Hủy

    include _script.pug
