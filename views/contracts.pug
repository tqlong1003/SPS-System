doctype html
html
  head
    title Quản lý hợp đồng - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") Danh sách nhân viên
            a.submenu-item(href="#") Danh sách tài khoản

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon.rotate
          .submenu.show
            a.submenu-item(href="/departments") Phòng ban
            a.submenu-item(href="/positions") Chức vụ
            a.submenu-item(href="#") Trình độ
            a.submenu-item(href="#") Chuyên môn
            a.submenu-item(href="#") Bằng cấp
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item.active(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span #{user.role === 'admin' ? 'Quản lý lương' : 'Phiếu lương'}
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/salary") Bảng tính lương
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương

        // --- QUẢN LÝ CÔNG TÁC ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-plane-departure
              span Quản lý công tác
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Danh sách công tác

        // --- KHEN THƯỞNG - KỶ LUẬT ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-award
              span Khen thưởng - Kỷ luật
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Khen thưởng
            a.submenu-item(href="#") Kỷ luật

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Thông tin tài khoản
            a.submenu-item(href="#") Danh sách tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="#") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm hợp đồng...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 📄 Quản lý hợp đồng
          p Danh sách thông tin và thời hạn các hợp đồng lao động

        if user.role === 'admin'
          a.btn(href="/contracts/add" style="display: inline-block; margin-bottom: 15px; text-decoration: none;") ➕ Thêm hợp đồng
        
        .table-container
          table
            thead
              tr
                th Số hợp đồng
                th Loại hợp đồng
                th Ngày ký
                th Thời hạn
                if user.role === 'admin'
                  th Thao tác
            tbody
              if contracts && contracts.length > 0
                each c in contracts
                  tr
                    td(style="font-weight: bold;")= c.contractNumber
                    td= c.contractType
                    td= c.signDate
                    td= c.duration
                    if user.role === 'admin'
                      td
                        a.btn-edit(href=`/contracts/edit/${c._id}`) Sửa
                        a.btn-delete(href=`/contracts/delete/${c._id}`, onclick="return confirm('Xác nhận xóa?')", style="margin-left: 5px;") Xóa
              else
                tr
                  td(colspan=user.role === 'admin' ? "5" : "4", style="text-align: center; padding: 20px;") Chưa có hợp đồng nào

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });