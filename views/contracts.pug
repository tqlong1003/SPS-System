doctype html
html
  head
    title Quản lý hợp đồng - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi


        

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      header.topbar
        form.search-bar(method="GET", action="/contracts")
          i.fas.fa-search
          input(type="text", name="keyword", value=searchKeyword || '', placeholder="Tìm theo mã hợp đồng...")
          button(type="submit", style="border: none; background: var(--primary); color: white; padding: 8px 14px; border-radius: 8px; cursor: pointer;") Tìm
          if searchKeyword
            a(href="/contracts", style="color: var(--text-secondary); text-decoration: none; font-weight: 600;") Xóa
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 📄 Quản lý hợp đồng
          p= user.role === 'admin' ? 'Danh sách thông tin và thời hạn các hợp đồng lao động' : 'Thông tin hợp đồng lao động của bạn'

        if user.role === 'admin'
          a.btn-add(href="/contracts/add" style="margin-bottom: 15px;")
            | ➕ Thêm hợp đồng
        
        .table-container
          table
            thead
              tr
                th Số hợp đồng
                th Loại hợp đồng
                th Ngày ký
                th Thời hạn
                if user.role === 'admin'
                  th Thao tác
            tbody
              if contracts && contracts.length > 0
                each c in contracts
                  tr
                    td(style="font-weight: bold;")= c.contractNumber
                    td= c.contractType
                    td= c.signDate
                    td= c.duration
                    if user.role === 'admin'
                      td
                        a.btn-edit(href=`/contracts/edit/${c._id}`) Sửa
                        a.btn-delete(href=`/contracts/delete/${c._id}`, onclick="return confirm('Xác nhận xóa?')", style="margin-left: 5px;") Xóa
              else
                tr
                  td(colspan=user.role === 'admin' ? "5" : "4", style="text-align: center; padding: 20px;")= searchKeyword ? 'Không tìm thấy hợp đồng phù hợp' : 'Chưa có hợp đồng nào'

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });