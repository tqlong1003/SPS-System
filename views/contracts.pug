doctype html
html
  head
    title Quản lý hợp đồng
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Chèn trực tiếp nội dung Sidebar
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      .sidebar-menu
        p.menu-label CHÍNH
        a.menu-item(href="/dashboard")
          i.fas.fa-th-large
          span Tổng quan
        p.menu-label NHÂN SỰ
        a.menu-item(href="/employees")
          i.fas.fa-users
          span Nhân viên
        a.menu-item(href="/departments")
          i.fas.fa-sitemap
          span Phòng ban
        a.menu-item(href="/positions")
          i.fas.fa-briefcase
          span Chức vụ
        a.menu-item.active(href="/contracts")
          i.fas.fa-file-contract
          span Hợp đồng
        p.menu-label TÀI CHÍNH
        a.menu-item(href="/salary")
          i.fas.fa-file-invoice-dollar
          span #{user.role === 'admin' ? 'Quản lý lương' : 'Phiếu lương'}
      .sidebar-footer
        a.logout-btn(href="/logout")
          i.fas.fa-sign-out-alt
          span Đăng xuất

    main.main-content
      .content-wrapper
        .header-flex
          h1 Danh sách Hợp đồng
          if user.role === 'admin'
            a.add-btn(href="/contracts/add") + Thêm hợp đồng
        
        table.styled-table
          thead
            tr
              th Số hợp đồng
              th Loại hợp đồng
              th Ngày ký
              th Thời hạn
              if user.role === 'admin'
                th Thao tác
          tbody
            each c in contracts
              tr
                td= c.contractNumber
                td= c.contractType
                td= c.signDate
                td= c.duration
                if user.role === 'admin'
                  td
                    a.edit-link(href=`/contracts/edit/${c._id}`) Sửa
                    a.delete-link(href=`/contracts/delete/${c._id}`, onclick="return confirm('Xác nhận xóa?')") Xóa