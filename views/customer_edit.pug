doctype html
html
  head
    title Sửa khách hàng - PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    include sidebar.pug
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào,
            strong= user.name || user.username
          .avatar= (user.name || user.username).charAt(0).toUpperCase()

      .content-wrapper
        .card-form
          .card-header
            i.fas.fa-user-edit
            h2 Cập nhật khách hàng

          form(method="POST" action=`/customers/edit/${customer._id}`)
            .form-group
              label Mã khách hàng
              input(name="customerCode" value=customer.customerCode required)
            .form-group
              label Họ và tên
              input(name="name" value=customer.name required)
            .form-group
              label Số điện thoại
              input(name="phone" value=customer.phone)
            .form-group
              label Email
              input(type="email" name="email" value=customer.email)
            .form-group
              label Địa chỉ
              input(name="address" value=customer.address)
            .form-group
              label Ngày sinh
              input(type="date" name="birthDate" value=customer.birthDate)
            .form-group
              label Nhân viên phụ trách
              select(name="assignedTo")
                option(value="") -- Chưa phân công --
                each s in staffList
                  option(value=s._id selected=(customer.assignedTo && customer.assignedTo.toString() === s._id.toString()))= s.name || s.username
            .form-group
              label Ghi chú
              input(name="note" value=customer.note)

            .form-actions
              button.btn-save(type="submit") Lưu thay đổi
              a.btn-cancel(href="/customers") Hủy

    include _script.pug
