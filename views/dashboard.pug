doctype html
html
  head
    title HRM System - Dashboard
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug

    // Khu vực bên phải
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 👋 Chào mừng, #{user.username}
          p Quản lý hệ thống nhân sự một cách hiệu quả và nhanh chóng

        .dashboard-notifications
          .dashboard-notifications-header
            h3
              i.fas.fa-bullhorn
              |  Thông báo mới nhất
            a(href="/notifications") Xem tất cả →
          if latestNotifications && latestNotifications.length > 0
            each n in latestNotifications
              a.dashboard-notification-item(href="/notifications")
                span.notification-badge.announce Thông báo
                .dashboard-notification-text
                  strong= n.title
                  span= new Date(n.createdAt).toLocaleString('vi-VN')
          else
            p.dashboard-notification-empty Hiện chưa có thông báo nào được đăng

        if user.role === 'admin' && dashboardStats && dashboardStats.employeesDueForRaise && dashboardStats.employeesDueForRaise.length > 0
          .dashboard-notifications
            .dashboard-notifications-header
              h3
                i.fas.fa-arrow-trend-up
                |  Nhân viên sắp đến hạn xét tăng lương
              a(href="/employees") Xem danh sách nhân viên →
            each item in dashboardStats.employeesDueForRaise
              a.dashboard-notification-item(href="/employees")
                span.notification-badge.announce= item.daysUntilReview + ' ngày'
                .dashboard-notification-text
                  strong= `${item.employeeName} (${item.employeeCode}) - ${item.department}`
                  span= `Đến hạn xét lương: ${item.nextReviewDate} • ${item.basis}`

        if user.role === 'admin'
          .stats-grid
            a.stat-card(href="/employees")
              .stat-icon.blue
                i.fas.fa-user-check
              .stat-info
                span Nhân viên hiện tại
                h2= dashboardStats ? dashboardStats.employeeCount : 0
            a.stat-card(href="/departments")
              .stat-icon.green
                i.fas.fa-building
              .stat-info
                span Phòng ban
                h2= dashboardStats ? dashboardStats.departmentCount : 0
            a.stat-card(href="/salary/provisional")
              .stat-icon.orange
                i.fas.fa-clock
              .stat-info
                span Chờ duyệt lương
                h2= dashboardStats ? dashboardStats.pendingSalaryCount : 0
            .stat-card.contract-stat-card
              .stat-icon.blue
                i.fas.fa-file-contract
              .stat-info
                a.stat-link(href="/contracts")
                  span Hợp đồng
                  h2= dashboardStats ? dashboardStats.contractCount : 0
                a.contract-alert-link(href="/contracts?filter=expiring")
                  | Sắp hết hạn: 
                  strong= dashboardStats ? dashboardStats.expiringContracts.length : 0
            a.stat-card(href="/employees")
              .stat-icon.orange
                i.fas.fa-arrow-trend-up
              .stat-info
                span Sắp đến hạn xét lương
                h2= dashboardStats ? dashboardStats.employeesDueForRaise.length : 0
        else
          .stats-grid
            a.stat-card(href="/profile")
              .stat-icon.blue
                i.fas.fa-id-card
              .stat-info
                span Hồ sơ cá nhân
                h2 01
            a.stat-card(href="/attendance")
              .stat-icon.green
                i.fas.fa-calendar-check
              .stat-info
                span Chấm công
                h2 Cá nhân
            a.stat-card(href="/salary")
              .stat-icon.orange
                i.fas.fa-wallet
              .stat-info
                span Phiếu lương
                h2 Cá nhân

    // Script xử lý đóng/mở mượt mà cho Dropdown Menu
    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          // Đóng các menu khác
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if (icon) icon.classList.remove('rotate');
            }
          });

          // Bật/tắt menu hiện tại
          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });
