doctype html
html
head
title PhoneShop CRM - Dashboard
link(rel="stylesheet", href="/public/style.css")
link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")

body.dashboard-body
include sidebar.pug


main.main-content
  header.topbar
    .search-bar
      i.fas.fa-search
      input(type="text" placeholder="Tìm kiếm nhanh...")

    .user-info
      span.welcome Xin chào,
        strong= user.name || user.username
      .avatar= (user.name || user.username).charAt(0).toUpperCase()

  .content-wrapper

    .welcome-banner
      h1 📱 Chào mừng, #{user.name || user.username}
      p Quản lý bán hàng và chăm sóc khách hàng cho cửa hàng điện thoại một cách hiệu quả

    // ================= SẢN PHẨM SẮP HẾT HÀNG =================
    if dashboardStats && dashboardStats.lowStockProducts && dashboardStats.lowStockProducts.length > 0
      .dashboard-notifications
        .dashboard-notifications-header
          h3
            i.fas.fa-triangle-exclamation
            |  Sản phẩm sắp hết hàng

          a(href="/products?filter=lowstock") Xem toàn bộ kho →

        each p in dashboardStats.lowStockProducts
          a.dashboard-notification-item(href="/products?filter=lowstock")
            span.notification-badge.announce= p.stockQty + ' còn lại'

            .dashboard-notification-text
              strong= p.name
              span= `Mã SP: ${p.sku || 'N/A'}`

    // ================= BẢO HÀNH SẮP HẾT HẠN =================
    if dashboardStats && dashboardStats.expiringWarranties && dashboardStats.expiringWarranties.length > 0
      .dashboard-notifications
        .dashboard-notifications-header
          h3
            i.fas.fa-shield-halved
            |  Bảo hành sắp hết hạn

          a(href="/warranties?filter=expiring") Xem danh sách bảo hành →

        each w in dashboardStats.expiringWarranties
          a.dashboard-notification-item(href="/warranties?filter=expiring")
            span.notification-badge.announce= w.daysUntilExpiration + ' ngày'

            .dashboard-notification-text
              strong= `${w.productName || 'Chưa rõ sản phẩm'} (${w.warrantyCode || ''})`
              span= `Hết hạn: ${w.expiryDate}`

    // ================= DASHBOARD ADMIN =================
    if user.role === 'admin'
      .stats-grid

        // Khách hàng
        a.stat-card(href="/customers")
          .stat-icon.blue
            i.fas.fa-address-book

          .stat-info
            span Khách hàng
            h2= dashboardStats ? dashboardStats.customerCount : 0

        // Sản phẩm
        a.stat-card(href="/products")
          .stat-icon.orange
            i.fas.fa-mobile-alt

          .stat-info
            span Sản phẩm trong kho
            h2= dashboardStats ? dashboardStats.productCount : 0

        // Đơn hàng
        a.stat-card(href="/orders")
          .stat-icon.green
            i.fas.fa-cash-register

          .stat-info
            span Đơn hàng đang mở
            h2= dashboardStats ? dashboardStats.openOrderCount : 0

        // Phiếu bảo hành
        .stat-card.contract-stat-card
          .stat-icon.blue
            i.fas.fa-shield-halved

          .stat-info
            a.stat-link(href="/warranties")
              span Phiếu bảo hành
              h2= dashboardStats ? dashboardStats.warrantyCount : 0

            a.contract-alert-link(href="/warranties?filter=expiring")
              | Sắp hết hạn:
              strong= dashboardStats ? dashboardStats.expiringWarranties.length : 0

        // Nhân viên
        .stat-card.contract-stat-card
          .stat-icon.green
            i.fas.fa-user-tie

          .stat-info
            a.stat-link(href="/employees")
              span Tổng số nhân viên
              h2= dashboardStats ? dashboardStats.employeeCount : 0

            a.contract-alert-link(href="/employees?status=Đang làm việc")
              | Đang làm việc:
              strong= dashboardStats ? dashboardStats.activeEmployeeCount : 0

    // ================= DASHBOARD NHÂN VIÊN =================
    if user.role !== 'admin'
      .stats-grid

        // Khách hàng phụ trách
        a.stat-card(href="/customers")
          .stat-icon.blue
            i.fas.fa-address-book

          .stat-info
            span Khách hàng phụ trách
            h2= dashboardStats ? dashboardStats.customerCount : 0

        // Đơn hàng đang xử lý
        a.stat-card(href="/orders")
          .stat-icon.green
            i.fas.fa-cash-register

          .stat-info
            span Đơn hàng đang xử lý
            h2= dashboardStats ? dashboardStats.openOrderCount : 0

        // Phiếu bảo hành của tôi
        a.stat-card(href="/warranties")
          .stat-icon.orange
            i.fas.fa-shield-halved

          .stat-info
            span Phiếu bảo hành của tôi
            h2= dashboardStats ? dashboardStats.warrantyCount : 0

include _script.pug

