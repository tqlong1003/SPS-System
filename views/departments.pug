doctype html
html
  head
    title Quản lý phòng ban - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") Danh sách nhân viên
            a.submenu-item(href="#") Danh sách tài khoản

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon.rotate
          .submenu.show
            a.submenu-item.active(href="/departments") Phòng ban
            a.submenu-item(href="/positions") Chức vụ
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span #{user.role === 'admin' ? 'Quản lý lương' : 'Phiếu lương'}
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟

        // --- QUẢN LÝ CÔNG TÁC ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-plane-departure
              span Quản lý công tác
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Danh sách công tác

        // --- KHEN THƯỞNG - KỶ LUẬT ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-award
              span Khen thưởng - Kỷ luật
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Khen thưởng
            a.submenu-item(href="#") Kỷ luật

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Thông tin tài khoản
            a.submenu-item(href="#") Danh sách tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="#") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm phòng ban...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 🏢 Danh sách phòng ban
          p Quản lý cơ cấu bộ máy tổ chức của hệ thống cơ sở

        if user.role === 'admin'
          a.btn(href="/departments/add" style="display: inline-block; margin-bottom: 15px; text-decoration: none;")
            i.fas.fa-plus
            |  Thêm phòng ban

        .table-container
          table
            thead
              tr
                th Tên phòng ban
                th Trưởng phòng
                if user.role === 'admin'
                  th Hành động
            tbody
              if departments && departments.length > 0
                each dept in departments
                  tr
                    td(style="font-weight: bold;")= dept.name
                    td= dept.manager ? dept.manager : "Chưa cập nhật"
                    if user.role === 'admin'
                      td
                        a.btn-edit(href=`/departments/edit/${dept._id}`) Sửa
                        a.btn-delete(href=`/departments/delete/${dept._id}` style="margin-left: 5px;") Xóa
              else
                tr
                  td(colspan=user.role === 'admin' ? "3" : "2", style="text-align: center; padding: 20px;") Chưa có dữ liệu phòng ban

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });