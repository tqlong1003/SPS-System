doctype html
html
  head
    title HRM System - Chỉnh sửa nhân viên
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    style.
      .form-row { display: flex; gap: 20px; }
      .form-row .form-group { flex: 1; }
      @media (max-width: 768px) { .form-row { flex-direction: column; gap: 0; } }
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug


    // Main Content bên phải
    .main-content
      header.top-nav
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}
      
      .content-wrapper
        .welcome-banner
          h1 📝 Chỉnh sửa hồ sơ nhân viên
          p Cập nhật lại các thông tin thay đổi của nhân viên vào hệ thống.
        
        .card(style="max-width: 900px; margin: 30px auto;")
          if error
            .alert(style="background: #fff3f3; border: 1px solid #e74c3c; border-radius: 8px; padding: 14px 18px; margin-bottom: 20px; color: #c0392b; display: flex; align-items: center; gap: 10px;")
              i.fas.fa-exclamation-circle
              span ❌ #{error}
          .card-header
            i.fas.fa-user-edit(style="color: var(--primary);")
            h2 Sơ sơ yếu lý lịch nhân viên

          form(method="POST" enctype="multipart/form-data")
            // KHỐI 1: THÔNG TIN CƠ BẢN
            h3(style="margin-bottom: 15px; color: var(--primary); border-bottom: 1px solid #eee; padding-bottom: 5px;") 
              i.fas.fa-id-card(style="margin-right: 8px;") 
              | Thông tin cơ bản & liên hệ
            
            .form-row
              .form-group
                label Mã nhân viên <span style="color:red">*</span>
                input(type="text" name="employeeCode" value=emp.employeeCode placeholder="Ví dụ: NV001" required)
              .form-group
                label Tên nhân viên <span style="color:red">*</span>
                input(type="text" name="name" value=emp.name placeholder="Nhập họ và tên đầy đủ" required)
            
            .form-row
              .form-group
                label Ảnh đại diện (Chọn tệp ảnh)
                input(type="file" name="avatar" accept="image/*")
                if emp.avatar
                  div(style="margin-top: 5px;")
                    small Ảnh hiện tại:
                    a(href=emp.avatar target="_blank" style="color: var(--primary);") Xem ảnh
              .form-group
                label Giới tính
                select(name="gender")
                  option(value="Nam" selected=emp.gender==='Nam') Nam
                  option(value="Nữ" selected=emp.gender==='Nữ') Nữ
                  option(value="Khác" selected=emp.gender==='Khác') Khác

            .form-row
              .form-group
                label Ngày sinh
                input(type="date" name="dob" value=emp.dob)
              .form-group
                label Số CCCD / CMND
                input(type="text" name="cccd" value=emp.cccd placeholder="Nhập 12 số định danh công dân")

            .form-row
              .form-group
                label Quê quán
                input(type="text" name="hometown" value=emp.hometown placeholder="Quê quán đăng ký khai sinh")
              .form-group
                label Nơi ở tạm trú
                input(type="text" name="temporaryAddress" value=emp.temporaryAddress placeholder="Địa chỉ nơi ở hiện tại")

            .form-row
              .form-group
                label Số điện thoại
                input(type="tel" name="phone" value=emp.phone placeholder="Ví dụ: 0912345678" pattern="[0-9]{10,11}")
              .form-group
                label Email
                input(type="email" name="email" value=emp.email placeholder="Ví dụ: ten@congty.com")

            // KHỐI 2: CÔNG VIỆC & VỊ TRÍ
            h3(style="margin: 25px 0 15px 0; color: var(--primary); border-bottom: 1px solid #eee; padding-bottom: 5px;") 
              i.fas.fa-briefcase(style="margin-right: 8px;") 
              | Công việc & vị trí
            
            .form-row
              .form-group
                label Phòng ban
                select(name="department")
                  option(value="" disabled selected=!emp.department) -- Chọn phòng ban --
                  if departments && departments.length
                    each dept in departments
                      option(value=dept.name selected=emp.department===dept.name) #{dept.name}
                  else
                    option(value=emp.department selected) #{emp.department}
              .form-group
                label Chức vụ
                select(name="role")
                  option(value="" disabled selected=!emp.role) -- Chọn chức vụ --
                  if positions && positions.length
                    each pos in positions
                      option(value=pos.posName selected=emp.role===pos.posName) #{pos.posName}
                  else
                    option(value=emp.role selected) #{emp.role}

            .form-row
              .form-group
                label Loại nhân viên
                select(name="employeeType")
                  option(value="Chính thức" selected=emp.employeeType==='Chính thức') Chính thức
                  option(value="Thử việc" selected=emp.employeeType==='Thử việc') Thử việc
                  option(value="Thực tập" selected=emp.employeeType==='Thực tập') Thực tập
              .form-group
                label Trạng thái làm việc
                select(name="status")
                  option(value="Đang làm việc" selected=emp.status==='Đang làm việc') Đang làm việc
                  option(value="Thử việc" selected=emp.status==='Thử việc') Thử việc
                  option(value="Đã nghỉ việc" selected=emp.status==='Đã nghỉ việc') Đã nghỉ việc

            .form-row
              .form-group
                label Lương cứng (VNĐ)
                input(type="number" name="basicSalary" value=emp.basicSalary placeholder="Ví dụ: 10000000")
              .form-group
                label Ngày vào làm
                input(type="date" name="joinDate" value=emp.joinDate)
                small(style="color: var(--text-secondary); display: block; margin-top: 4px;") Dùng làm mốc tính chu kỳ xét tăng lương lần đầu (xem Dashboard)

            .form-row
              .form-group
                label Lần tăng lương gần nhất
                if emp.lastRaiseDate
                  input(type="text" value=new Date(emp.lastRaiseDate).toLocaleDateString('vi-VN') disabled style="background: #f5f5f5; cursor: not-allowed;")
                else
                  input(type="text" value="Chưa từng được tăng lương" disabled style="background: #f5f5f5; cursor: not-allowed; color: var(--text-secondary);")
                small(style="color: var(--text-secondary); display: block; margin-top: 4px;") Tự động cập nhật khi duyệt phiếu lương có khoản tăng lương, không sửa tay tại đây

            .form-actions(style="margin-top: 30px; display: flex; gap: 15px; justify-content: flex-end;")
              button.btn-save(type="submit") 
                i.fas.fa-save(style="margin-right: 8px;")
                | Lưu hồ sơ nhân viên
              a.btn-cancel(href="/employees" class="btn" style="text-decoration: none;") 
                i.fas.fa-times(style="margin-right: 8px;")
                | Hủy bỏ

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          if (toggleIcon) toggleIcon.classList.toggle('rotate');
        });
      });