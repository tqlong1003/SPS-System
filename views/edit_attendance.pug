doctype html
html
  head
    title Chỉnh sửa chấm công - SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi



        

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .center-wrapper
        .card-form
          .card-header
            i.fas.fa-edit
            h2 Cập nhật chấm công

          form(action=`/attendance/edit/${attendance._id}`, method="POST")
            .form-group
              label(for="employeeId") Nhân viên
              select(name="employeeId", id="employeeId", required)
                each employee in employees
                  option(value=employee._id selected=(employee._id.toString() === attendance.employeeId.toString()))= employee.name

            .form-group
              label(for="date") Ngày chấm công
              input(type="date", name="date", id="date", value=attendance.workDate, required)

            .form-group
              label(for="status") Trạng thái
              select(name="status", id="status", required)
                option(value="present" selected=(attendance.status === 'present')) Có mặt
                option(value="absent" selected=(attendance.status === 'absent')) Vắng mặt
                option(value="leave" selected=(attendance.status === 'leave')) Xin nghỉ

            .form-group
              label(for="overtime") Tăng ca
              label.checkbox-field(for="overtime")
                input(type="checkbox", name="overtime", id="overtime", checked=attendance.overtime)
                span Đánh dấu nếu nhân viên có tăng ca

            .form-actions
              button.btn-save(type="submit") Cập nhật
              a.btn-cancel(href="/attendance") Hủy

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          menuGroup.querySelector('.submenu').classList.toggle('show');
          this.querySelector('.toggle-icon').classList.toggle('rotate');
        });
      });