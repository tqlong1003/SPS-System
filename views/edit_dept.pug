doctype html
html
  head
    title Cập nhật phòng ban - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái (Đồng bộ chuẩn 100% theo trang chủ)
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") Danh sách nhân viên
            a.submenu-item(href="#") Danh sách tài khoản

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon.rotate
          .submenu.show
            a.submenu-item(href="/departments") Phòng ban
            a.submenu-item(href="/positions") Chức vụ
            a.submenu-item(href="#") Trình độ
            a.submenu-item(href="#") Chuyên môn
            a.submenu-item(href="#") Bằng cấp
            a.submenu-item.active(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên

        // --- QUẢN LÝ HỢP ĐỒNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-signature
              span Quản lý hợp đồng
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/contracts") Danh sách hợp đồng
            if user && user.role === 'admin'
              a.submenu-item(href="/contracts/add") Thêm hợp đồng mới

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user && user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟

        // --- QUẢN LÝ CHẤM CÔNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-calendar-check
              span Quản lý chấm công
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Bảng chấm công
            a.submenu-item(href="#") Đăng ký nghỉ phép

        // --- QUẢN LÝ CÔNG TÁC ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-plane-departure
              span Quản lý công tác
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Danh sách công tác

        // --- KHEN THƯỞNG - KỶ LUẬT ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-award
              span Khen thưởng - Kỷ luật
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Khen thưởng
            a.submenu-item(href="#") Kỷ luật

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Thông tin tài khoản
            a.submenu-item(href="#") Danh sách tài khoản
            if user && user.role === 'admin'
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="#") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất

    // Khu vực nội dung bên phải
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        
        if user
          .user-info
            span.welcome Xin chào, 
              strong #{user.username}
            .avatar #{user.username.charAt(0).toUpperCase()}

      .center-wrapper
        .card-form
          .card-header
            i.fas.fa-edit
            h2 Cập nhật phòng ban
          
          form(method="POST", action=`/departments/edit/${dept._id}`)
            .form-group
              label Tên phòng ban
              input(type="text", name="name", value=dept.name, required)
            .form-group
              label Mô tả
              input(type="text", name="description", value=dept.description)
            .form-group
              label Trưởng phòng
              input(type="text", name="manager", value=dept.manager)
            .form-group
              label Ngày thành lập
              input(type="date", name="establishmentDate", value=dept.establishmentDate ? new Date(dept.establishmentDate).toISOString().split('T')[0] : '')
            .form-actions
              button.btn-save(type="submit") Cập nhật
              a.btn-back(href="/departments") 
                i.fas.fa-arrow-left
                span  Quay lại

    // Script đóng mở menu
    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });