doctype html
html
  head
    title Sửa thông báo - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug

    // Khu vực nội dung bên phải
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 ✏️ Sửa thông báo
          p Cập nhật lại nội dung đã đăng cho toàn bộ nhân viên

        .center-wrapper
          .card-form
            .card-header
              i.fas.fa-bullhorn
              h2 Chỉnh sửa nội dung

            if error
              .alert-error= error

            form(method="POST" action=`/notifications/edit/${notification._id}` enctype="multipart/form-data")
              .form-group
                label Tiêu đề
                input(type="text" name="title" value=notification.title required)

              .form-group
                label Nội dung chi tiết
                textarea(name="content" rows="6" required style="width: 100%; padding: 12px 15px; border: 1.5px solid #e5e7eb; border-radius: 10px; font-size: 1rem; font-family: inherit; resize: vertical;")= notification.content

              .form-group
                label Văn bản đính kèm hiện tại
                if notification.attachmentUrl
                  p(style="margin-bottom: 10px;")
                    a.notification-attachment(href=notification.attachmentUrl target="_blank" rel="noopener")
                      i.fas.fa-paperclip
                      |  #{notification.attachmentName || 'Xem văn bản đính kèm'}
                else
                  p(style="margin-bottom: 10px; color: #9ca3af; font-style: italic;") Chưa có file đính kèm
                label Tải file mới để thay thế (bỏ trống nếu giữ nguyên)
                input(type="file" name="attachment" style="background: white; border: 1.5px solid #e5e7eb; padding: 10px 15px;")

              .form-group(style="display: flex; align-items: center; gap: 10px;")
                input(type="checkbox" name="pinned" id="pinned" checked=notification.pinned style="width: auto; margin: 0;")
                label(for="pinned" style="margin: 0; cursor: pointer;") Ghim quan trọng lên đầu danh sách

              .form-actions
                button.btn-save(type="submit")
                  i.fas.fa-check-circle
                  |  Lưu thay đổi
                a.btn-cancel(href="/notifications") Hủy bỏ

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');

          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if (icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });
