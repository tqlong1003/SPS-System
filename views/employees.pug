doctype html
html
head
  title PhoneShop CRM - Quản lý nhân viên
  link(rel="stylesheet", href="/public/style.css")
  link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")

body.dashboard-body
  include sidebar.pug

  main.main-content
    header.topbar
      .search-bar
        i.fas.fa-search
        input(type="text" placeholder="Tìm kiếm nhanh...")

      .user-info
        span.welcome Xin chào,
          strong= user.name || user.username
        .avatar= (user.name || user.username).charAt(0).toUpperCase()

    .content-wrapper

      .welcome-banner
        h1
          i.fas.fa-user-tie
          |  Quản lý nhân viên
        p Kiểm soát số lượng nhân viên và trạng thái làm việc của cửa hàng

      .attendance-toolbar
        .attendance-filter-card
          .attendance-filter-header
            i.fas.fa-user-tie
            |  Tổng quan nhân sự

          .employee-summary
            span Tổng số nhân viên: 
              strong= totalCount
            span Đang làm việc: 
              strong= activeCount
            span Ngưng làm việc: 
              strong= inactiveCount


      .table-container
        table
          thead
            tr
              th Mã NV
              th Họ tên
              th Năm sinh
              th Giới tính
              th Số điện thoại
              th Chức vụ
              th Ngày vào làm
              th Trạng thái
              th Hành động
          tbody
            if employees && employees.length
              each e in employees
                tr
                  td
                    span= e.employeeCode
                    if e.userId
                      i.fas.fa-link(style="margin-left:6px; color:#6366f1;" title="Đã có tài khoản đăng nhập liên kết")
                  td= e.name
                  td= e.birthYear || 'Chưa cập nhật'
                  td= e.gender || 'Chưa cập nhật'
                  td= e.phone || 'Chưa cập nhật'
                  td= e.position || 'Nhân viên'
                  td= e.startDate || 'Chưa cập nhật'
                  td
                    span.status-badge(class=(e.status === 'Đang làm việc' ? 'status-active' : 'status-inactive'))= e.status
                  td
                    a.btn-edit(href=`/employees/detail/${e._id}` title="Xem chi tiết nhân viên") Chi tiết
                    a.btn-edit(href=`/employees/edit/${e._id}`) Sửa
                    a.btn-delete(href=`/employees/delete/${e._id}` onclick="return confirm('Xóa hồ sơ nhân viên này?')") Xóa
            else
              tr
                td(colspan="9" style="text-align:center; color:#9ca3af; padding: 24px;") Chưa có nhân viên nào

  include _script.pug
