doctype html
html
  head
    title Yêu cầu bàn giao - PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    include sidebar.pug

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào,
            strong= user.name || user.username
          .avatar= (user.name || user.username).charAt(0).toUpperCase()


      .content-wrapper
        .card-form
          .card-header
            i.fas.fa-right-left
            h2= user.role === 'admin' ? 'Tạo bàn giao khách hàng' : 'Gửi yêu cầu bàn giao khách hàng'

          if error
            p.alert-error= error

          if user.role === 'admin'
            form(method="GET" action="/handovers/new" style="margin-bottom: 18px;")
              .form-group
                label Nhân viên cần bàn giao
                select(name="from" onchange="this.form.submit()")
                  option(value="") -- Chọn nhân viên --
                  each s in staffList
                    option(value=s._id selected=(fromStaffId === String(s._id)))= s.name || s.username

          if !fromStaffId
            p(style="color:#888;") Hãy chọn nhân viên để xem danh sách khách hàng họ đang chuyên quản.
          else if !candidates.length
            p(style="color:#888;") Hiện không có khách hàng nào đang do nhân viên này chuyên quản, nên không có gì để bàn giao.
          else
            form(method="POST" action="/handovers/new")
              input(type="hidden" name="fromStaffId" value=fromStaffId)

              .form-group
                label Lý do bàn giao
                select#reasonType(name="reasonType" required)
                  option(value="") -- Chọn lý do --
                  each r in reasons
                    if r !== 'Đi làm lại' || returnCandidates.length
                      option(value=r selected=(form.reasonType === r))= r

              #leaveFields(style="display:none;")
                .form-row
                  .form-group
                    label Nghỉ từ ngày
                    input(type="date" name="leaveFrom" value=form.leaveFrom)
                  .form-group
                    label Dự kiến đi làm lại
                    input(type="date" name="leaveTo" value=form.leaveTo)

              .form-group
                label Ghi chú cho admin
                input(name="note" value=form.note placeholder="VD: Đang xử lý dở 2 đơn bảo hành, lưu ý khách Nguyễn Văn A")

              p#leaveHint(style="margin: 6px 0 10px; color:#888; font-size:0.9em;")
                if hasBackup
                  | Khách sẽ được bàn giao cho nhân viên chăm sóc phụ của nhân viên này: 
                  strong= backupName
                  | .
                else
                  span(style="color:#b06000; font-weight:600;")
                    if backupAway
                      = `Nhân viên chăm sóc phụ (${backupName}) đang tạm vắng. `
                    else
                      | Nhân viên này chưa có nhân viên chăm sóc phụ. 
                    | Khách sẽ được chuyển về admin để phân công cho nhân viên khác.
              p#returnHint(style="margin: 6px 0 10px; color:#888; font-size:0.9em; display:none;")
                | Đi làm lại: trả khách đang giữ hộ về đúng chủ cũ (cột "Trả về").

              .table-container(style="margin-bottom: 16px;")
                table
                  thead
                    tr
                      th(style="width:40px;")
                        input#checkAll(type="checkbox" checked)
                      th Mã KH
                      th Tên khách hàng
                      th SĐT
                      th Người nhận
                  tbody
                    each c in candidates
                      - var ret = returnCandidates.find(function (x) { return String(x._id) === String(c._id) })
                      tr.cust-row(data-return=(ret ? '1' : '0'))
                        td
                          input.cust-check(type="checkbox" name="customerIds" value=c._id checked=!c.locked disabled=c.locked)
                        td(style="font-weight:bold;")= c.customerCode
                        td= c.name
                        td= c.phone || '—'
                        td
                          if c.locked
                            span(style="color:#b06000; font-weight:600;") Đang nằm trong yêu cầu chờ duyệt khác
                          else
                            span.target-leave
                              if hasBackup
                                = backupName
                              else
                                span(style="color:#b06000; font-weight:600;") Chuyển về admin phân công
                            if ret
                              span.target-return(style="display:none;")= ret.returnToName ? `Trả về ${ret.returnToName}` : 'Trả về chủ cũ'
              .form-actions
                button.btn-save(type="submit")= user.role === 'admin' ? 'Tạo yêu cầu' : 'Gửi cho admin'
                a.btn-cancel(href="/handovers") Hủy

    include _script.pug
    script.
      (function () {
        var reason = document.getElementById('reasonType')
        var leave = document.getElementById('leaveFields')
        if (reason && leave) {
          var sync = function () {
            leave.style.display = reason.value === 'Nghỉ phép' ? 'block' : 'none'
            var isReturn = reason.value === 'Đi làm lại'
            var lh = document.getElementById('leaveHint'), rh = document.getElementById('returnHint')
            if (lh) lh.style.display = isReturn ? 'none' : ''
            if (rh) rh.style.display = isReturn ? '' : 'none'
            document.querySelectorAll('.cust-row').forEach(function (row) {
              var show = !isReturn || row.getAttribute('data-return') === '1'
              row.style.display = show ? '' : 'none'
              var cb = row.querySelector('.cust-check')
              if (cb && !show) { cb.checked = false }
              if (cb && show && !cb.disabled && isReturn) { cb.checked = true }
              var tl = row.querySelector('.target-leave'), tr = row.querySelector('.target-return')
              if (tl) tl.style.display = isReturn ? 'none' : ''
              if (tr) tr.style.display = isReturn ? '' : 'none'
            })
          }
          reason.addEventListener('change', sync)
          sync()
        }
        var all = document.getElementById('checkAll')
        if (all) all.addEventListener('change', function () {
          document.querySelectorAll('.cust-check:not(:disabled)').forEach(function (c) { c.checked = all.checked })
        })
      })()
