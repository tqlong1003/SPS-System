doctype html
html
  head
    title Nhân sự chức vụ #{pos.posName} - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        .menu-group
          a.menu-item.has-submenu.active(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu.show
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi

        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" id="searchInput" placeholder="Tìm kiếm nhân sự theo chức vụ...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 💼 Chức vụ #{pos.posName}
          p
            | Mã chức vụ: 
            strong #{pos.posCode || 'Chưa cập nhật'}
            |  &nbsp;·&nbsp; Tổng số: 
            strong #{employees.length} nhân sự

        a.btn(href="/positions" style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 16px; text-decoration: none;")
          i.fas.fa-arrow-left
          |  Quay lại danh sách chức vụ

        if employees && employees.length > 0
          .table-container
            table#empTable
              thead
                tr
                  th STT
                  th Mã NV
                  th Họ và tên
                  th Phòng ban
                  th Trạng thái
                  th Hành động
              tbody
                each emp, index in employees
                  tr
                    td(style="text-align: center; color: #888;")= index + 1
                    td
                      span(style="font-family: monospace; background: #f0f4ff; color: #3b4cca; padding: 2px 8px; border-radius: 4px; font-size: 0.9em;")= emp.employeeCode || 'Chưa có'
                    td(style="font-weight: 600;")
                      if emp.avatar
                        img(src=emp.avatar alt="avatar" style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover; margin-right: 8px; vertical-align: middle;")
                      else
                        span(style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: #d1e3ff; color: #1a73e8; font-weight: bold; font-size: 0.85em; margin-right: 8px; vertical-align: middle;")= emp.name ? emp.name.charAt(0).toUpperCase() : '?'
                      = emp.name || 'Chưa cập nhật'
                    td= emp.department || 'Chưa cập nhật'
                    td
                      if emp.status === 'Đang làm việc'
                        span(style="background: #e6f4ea; color: #137333; padding: 3px 10px; border-radius: 12px; font-size: 0.85em; font-weight: 600;")
                          i.fas.fa-circle(style="font-size: 0.6em; margin-right: 4px;")
                          = emp.status
                      else
                        span(style="background: #fce8e6; color: #c5221f; padding: 3px 10px; border-radius: 12px; font-size: 0.85em; font-weight: 600;")
                          = emp.status || 'Không rõ'
                    td
                      a.btn-edit(href=`/employees/detail/${emp._id}` style="text-decoration: none;")
                        i.fas.fa-eye(style="margin-right: 4px;")
                        | Xem
        else
          .table-container
            p(style="text-align: center; padding: 40px; color: #999;")
              i.fas.fa-user-slash(style="font-size: 2em; display: block; margin-bottom: 10px;")
              | Chức vụ này chưa có nhân sự nào

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });

      document.getElementById('searchInput').addEventListener('input', function() {
        const keyword = this.value.toLowerCase();
        document.querySelectorAll('#empTable tbody tr').forEach(row => {
          const text = row.innerText.toLowerCase();
          row.style.display = text.includes(keyword) ? '' : 'none';
        });
      });