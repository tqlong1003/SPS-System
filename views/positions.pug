doctype html
html
  head
    title Quản lý chức vụ - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug

    // Khu vực nội dung bên phải 
    main.main-content
      header.topbar
        form.search-bar(method="GET", action="/positions")
          i.fas.fa-search
          input(type="text", name="keyword", value=searchKeyword || '', placeholder="Tìm theo mã hoặc tên chức vụ...")
          button(type="submit", style="border: none; background: var(--primary); color: white; padding: 8px 14px; border-radius: 8px; cursor: pointer;") Tìm
          if searchKeyword
            a(href="/positions", style="color: var(--text-secondary); text-decoration: none; font-weight: 600;") Xóa
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 💼 Danh sách chức vụ
          p Quản lý danh mục các chức vụ chức danh hoạt động trong đơn vị

        if user.role === 'admin'
          a.btn-add(href="/positions/add" style="margin-bottom: 15px;")
            i.fas.fa-plus
            |  Thêm chức vụ

        .table-container
          table
            thead
              tr
                th Mã chức vụ
                th Tên chức vụ
                th(style="text-align: center;") Số nhân sự
                if user.role === 'admin'
                  th Thao tác
            tbody
              if positions && positions.length > 0
                each pos in positions
                  tr
                    td(style="font-weight: bold;")= pos.posCode
                    td= pos.posName
                    td(style="text-align: center;")
                      a(href=`/positions/${pos._id}/employees` style="display: inline-flex; align-items: center; gap: 6px; background: #e8f4fd; color: #1a73e8; padding: 4px 12px; border-radius: 20px; font-weight: 600; text-decoration: none; font-size: 0.92em;")
                        i.fas.fa-users(style="font-size: 0.85em;")
                        span= Number(pos.employeeCount || 0) + ' người'
                    if user.role === 'admin'
                      td
                        a.btn-edit(href=`/positions/edit/${pos._id}`) Sửa
                        a.btn-delete(href=`/positions/delete/${pos._id}`, onclick="return confirm('Xóa chức vụ này?')", style="margin-left: 5px;") Xóa
              else
                tr
                  td(colspan=user.role === 'admin' ? "4" : "3", style="text-align: center; padding: 20px;")= searchKeyword ? 'Không tìm thấy chức vụ phù hợp' : 'Chưa có dữ liệu chức vụ'

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });