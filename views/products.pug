doctype html
html
  head
    title Sản phẩm & Kho - PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    include sidebar.pug

    main.main-content
      header.topbar
        form.search-bar(method="GET", action="/products")
          i.fas.fa-search
          input(type="text", name="keyword", value=searchKeyword || '', placeholder="Tìm theo tên, mã SP, hãng, danh mục...")
          button(type="submit", style="border: none; background: var(--primary); color: white; padding: 8px 14px; border-radius: 8px; cursor: pointer;") Tìm
          if searchKeyword || showLowStockOnly
            a(href="/products", style="color: var(--text-secondary); text-decoration: none; font-weight: 600;") Xóa lọc
        .user-info
          span.welcome Xin chào,
            strong= user.name || user.username
          .avatar= (user.name || user.username).charAt(0).toUpperCase()

      .content-wrapper
        .welcome-banner
          h1 📦 Sản phẩm & Kho điện thoại
          p= user.role === 'customer' ? 'Các sản phẩm đang bán tại cửa hàng' : 'Quản lý danh mục điện thoại, iPad, phụ kiện và số lượng tồn kho theo model'

        if showLowStockOnly
          div(style="margin-bottom: 16px; padding: 14px 16px; border-radius: 10px; background: #fff7ed; color: #c2410c; font-weight: 600;")
            | Đang hiển thị các sản phẩm sắp hết hàng (tồn kho ≤ 5).

        if user.role === 'admin'
          a.btn-add(href="/products/add" style="margin-bottom: 15px;")
            i.fas.fa-plus
            |  Thêm sản phẩm

        .table-container
          table
            thead
              tr
                th(style="width: 110px;") Mã SP
                th Tên sản phẩm
                th(style="width: 110px;") Hãng
                th(style="width: 140px;") Danh mục
                th(style="width: 110px;") Màu
                th(style="width: 90px; text-align:center;")= user.role === 'customer' ? 'Tình trạng' : 'Tồn kho'
                th(style="width: 120px; text-align:center;") Chi tiết
                if user.role === 'admin'
                  th(style="width: 180px;") Hành động
            tbody
              if products && products.length > 0
                each p in products
                  tr
                    td(style="font-weight: bold;")= p.sku
                    td(style="font-weight: bold;")= p.name
                    td= p.brand
                    td= p.category
                    td= p.color || '—'
                    td(style="text-align:center;")
                      - var lowStock = Number(p.stockQty || 0) <= 5
                      if user.role === 'customer'
                        if Number(p.stockQty || 0) > 0
                          span(style="font-weight:700; color:#137333;") Còn hàng
                        else
                          span(style="font-weight:700; color:#c5221f;") Hết hàng
                      else
                        span(style=`font-weight:700; color:${lowStock ? '#c5221f' : '#137333'};`)= p.stockQty
                    td(style="text-align:center;")
                      a.btn-detail(href=`/products/detail/${p._id}`)
                        i.fas.fa-eye
                        |  Chi tiết
                    if user.role === 'admin'
                      td
                        a.btn-edit(href=`/products/edit/${p._id}`) Sửa
                        a.btn-delete(href=`/products/delete/${p._id}`, onclick="return confirm('Xóa sản phẩm này?')", style="margin-left: 5px;") Xóa
              else
                tr
                  td(colspan=user.role === 'admin' ? "8" : "7", style="text-align: center; padding: 20px;")= searchKeyword ? 'Không tìm thấy sản phẩm phù hợp' : 'Chưa có sản phẩm nào trong kho'

    include _script.pug
