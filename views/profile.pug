doctype html
html
  head
    title Thông tin tài khoản - PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    style.
      .avatar-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        background-color: #ddd;
        margin-bottom: 20px;
      }
  body.dashboard-body
    include sidebar.pug

    main.main-content
      .profile-container
        .card-profile
          .card-header
            i.fas.fa-user-circle
            h2 Thông tin cá nhân

          .avatar-section
            .avatar-placeholder= (account.name || user.username).charAt(0).toUpperCase()
            h3= account.name || 'Người dùng'
            p.role-text= account.role === 'admin' ? 'Quản trị viên (Admin)' : (account.role === 'customer' ? 'Khách hàng' : 'Nhân viên bán hàng')

          .profile-grid
            .form-group
              label Tên đăng nhập
              input(type="text" value=account.username disabled)
            .form-group
              label Họ tên
              input(type="text" value=(account.name || 'Chưa cập nhật') disabled)
            .form-group
              label Vai trò
              input(type="text" value=(account.role === 'admin' ? 'Quản trị viên' : (account.role === 'customer' ? 'Khách hàng' : 'Nhân viên bán hàng')) disabled)
            .form-group
              label Số điện thoại
              input(type="text" value=(account.phone || 'Chưa cập nhật') disabled)
            if account.role === 'customer' && customer
              .form-group
                label Mã khách hàng
                input(type="text" value=(customer.customerCode || 'Chưa cập nhật') disabled)
              .form-group
                label Email
                input(type="text" value=(customer.email || 'Chưa cập nhật') disabled)
              .form-group
                label Địa chỉ
                input(type="text" value=(customer.address || 'Chưa cập nhật') disabled)
              .form-group
                label Ngày sinh
                input(type="text" value=(customer.birthDate || 'Chưa cập nhật') disabled)

          if account.role === 'customer' && !customer
            p.alert-error Tài khoản chưa được liên kết với hồ sơ khách hàng. Vui lòng liên hệ cửa hàng.

          if account.role === 'customer'
            .stats-grid(style="margin-top: 20px;")
              .stat-card
                .stat-icon.blue
                  i.fas.fa-receipt
                .stat-info
                  span Đơn hàng của tôi
                  h2= myOrderCount
              .stat-card
                .stat-icon.green
                  i.fas.fa-shield-halved
                .stat-info
                  span Phiếu bảo hành
                  h2= myWarrantyCount

          if account.role === 'user'
            .stats-grid(style="margin-top: 20px;")
              .stat-card
                .stat-icon.blue
                  i.fas.fa-address-book
                .stat-info
                  span Khách hàng phụ trách
                  h2= myCustomerCount
              .stat-card
                .stat-icon.green
                  i.fas.fa-filter
                .stat-info
                  span Đơn hàng đang xử lý
                  h2= myOrderCount

          .action-footer
            if account.role === 'customer' && customer
              a.btn-back(href="/profile/edit" style="margin-right:10px;") Cập nhật thông tin
            a.btn-back(href="/dashboard") Quay lại Dashboard

    include _script.pug
