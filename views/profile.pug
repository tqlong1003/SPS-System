doctype html
html
  head
    title Thông tin tài khoản - SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    // Thêm style inline ở đây để sửa kích thước ảnh
    style.
      .avatar {
        width: 150px; /* Tăng kích thước chiều rộng */
        height: 150px; /* Tăng kích thước chiều cao, giữ tỷ lệ 1:1 cho hình tròn */
        border-radius: 50%; /* Giữ hình ảnh bo tròn */
        object-fit: cover; /* Đảm bảo hình ảnh được căn chỉnh tốt bên trong */
        margin-bottom: 20px; /* Khoảng cách phía dưới ảnh */
      }
      .avatar-placeholder {
        width: 150px; /* Tăng kích thước chiều rộng của placeholder */
        height: 150px; /* Tăng kích thước chiều cao của placeholder */
        border-radius: 50%; /* Giữ placeholder bo tròn */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px; /* Tăng kích thước chữ bên trong placeholder */
        background-color: #ddd; /* Màu nền cho placeholder */
        margin-bottom: 20px; /* Khoảng cách phía dưới placeholder */
      }
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi



        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      .profile-container
        .card-profile
          .card-header
            i.fas.fa-user-circle
            h2 Thông tin cá nhân
  
          if user.role === 'admin'
            .profile-grid
              .form-group
                label Tên đăng nhập
                input(type="text" value=user.username disabled)
              .form-group
                label Vai trò
                span.badge-admin Admin

            .action-footer
              a.btn-back(href="/dashboard") Quay lại Dashboard

          else
            .avatar-section
              if emp.avatar
                img.avatar(src=emp.avatar alt="Avatar")
              else
                .avatar-placeholder= user.username.charAt(0).toUpperCase()
              h3= emp.name || 'Người dùng'
              p.role-text= emp.department || 'Chưa cập nhật'

            .profile-grid
              .form-group
                label Tên đăng nhập
                input(type="text" value=user.username disabled)
              
              .form-group
                label Họ tên
                input(type="text" value=(emp.name || 'Chưa cập nhật') disabled)
              .form-group
                label Phòng ban
                input(type="text" value=(emp.department || 'Chưa cập nhật') disabled)
              .form-group
                label Chức vụ
                input(type="text" value=(emp.role || 'Chưa cập nhật') disabled)
              .form-group
                label Số điện thoại
                - var phone = emp.phone || 'Chưa cập nhật'
                - var maskedPhone = phone.length > 4 ? phone.slice(0, -4) + '****' : '****'
                input(type="text" value=maskedPhone disabled)
            
            .action-footer
              a.btn-back(href="/dashboard") Quay lại Trang chủ