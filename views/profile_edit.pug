doctype html
html
  head
    title Cập nhật thông tin - PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    include sidebar.pug
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-user-pen
          span(style="padding: 8px 0; color: var(--text-secondary);") Cập nhật thông tin liên hệ
        .user-info
          span.welcome Xin chào,
            strong= user.name || user.username
          .avatar= (user.name || user.username).charAt(0).toUpperCase()

      .content-wrapper
        .card-form
          .card-header
            i.fas.fa-user-pen
            h2 Cập nhật thông tin của tôi

          if error
            p.alert-error
              i.fas.fa-exclamation-circle(style="margin-right: 5px")
              | #{error}

          form(method="POST" action="/profile/edit")
            .form-group
              label Họ và tên
              input(name="name" value=customer.name required)
            .form-group
              label Số điện thoại
              input(name="phone" value=customer.phone)
            .form-group
              label Email
              input(type="email" name="email" value=customer.email)
            .form-group
              label Địa chỉ
              input(name="address" value=customer.address)
            .form-group
              label Ngày sinh
              input(type="date" name="birthDate" value=customer.birthDate)

            .form-actions
              button.btn-save(type="submit") Lưu thay đổi
              a.btn-cancel(href="/profile") Hủy

    include _script.pug
