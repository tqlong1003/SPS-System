doctype html
html
  head
    title Cấp tài khoản | PhoneShop CRM
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")

  body.dashboard-body

    include sidebar.pug

    main.main-content

      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào,
            strong= user.name || user.username
          .avatar= (user.name || user.username).charAt(0).toUpperCase()

      .content-wrapper
        - var f = form || {}
        - var selectedCustomerId = f.customerId || prefillCustomerId || ''
        - var isAdminUser = user.role === 'admin'
        //- Nhân viên chỉ cấp được tài khoản khách hàng
        - var isCustomerRole = !isAdminUser || f.role === 'customer' || (!!prefillCustomerId && !f.role)

        .card-form(style="margin: 0 auto;")

          .card-header
            i.fas.fa-user-plus
            h2 Cấp tài khoản mới

          if error
            p.alert-error
              i.fas.fa-exclamation-circle(style="margin-right: 5px")
              | #{error}

          form(method="POST" action="/register")

            if isAdminUser
              .form-group
                label Loại tài khoản
                select#roleSelect(name="role")
                  option(value="user" selected=!isCustomerRole) Nhân viên
                  option(value="customer" selected=isCustomerRole) Khách hàng
            else
              input#roleSelect(type="hidden" name="role" value="customer")
              .form-group
                label Loại tài khoản
                input(type="text" value="Khách hàng" readonly)

            .form-group
              label Họ và tên
              input(type="text" name="name" value=f.name)

            .form-group
              label Tên đăng nhập
              input(type="text" name="username" required minlength="3" value=f.username)

            .form-group
              label Mật khẩu mặc định
              input(type="password" name="password" required minlength="6")

            .form-group
              label Số điện thoại
              input(type="text" name="phone" value=f.phone)

            //- ===== Nhân viên =====
            if isAdminUser
              #staffBox(style=isCustomerRole ? 'display:none;' : '')
                .form-group
                  label Chức vụ
                  input(type="text" value="Nhân viên" readonly)

            //- ===== Khách hàng =====
            #customerBox(style=isCustomerRole ? '' : 'display:none;')
              .form-group
                label Hồ sơ khách hàng
                select#customerSelect(name="customerId")
                  option(value="") -- Tạo hồ sơ khách hàng mới --
                  each c in linkableCustomers
                    option(value=c._id selected=(String(c._id) === String(selectedCustomerId)))= `${c.customerCode || ''} - ${c.name} (${c.phone || 'chưa có SĐT'})`

              #newCustomerFields
                .form-group
                  label Mã khách hàng (để trống sẽ tự sinh)
                  input(type="text" name="customerCode" value=f.customerCode)
                .form-group
                  label Email
                  input(type="email" name="email" value=f.email)
                .form-group
                  label Địa chỉ
                  input(type="text" name="address" value=f.address)
                .form-group
                  label Ngày sinh
                  input(type="date" name="birthDate" value=f.birthDate)
                if isAdminUser
                  .form-group
                    label Nhân viên phụ trách
                    select(name="assignedTo")
                      option(value="") -- Chưa phân công --
                      each s in staffList
                        option(value=s._id selected=(String(s._id) === String(f.assignedTo)))= s.name || s.username
                else
                  .form-group
                    label Nhân viên phụ trách
                    input(type="text" value=(user.name || user.username) readonly)

            button(type="submit")
              i.fas.fa-plus-circle(style="margin-right: 8px;")
              | Tạo tài khoản ngay

    include _script.pug

    script.
      (function () {
        var role = document.getElementById('roleSelect')
        var staffBox = document.getElementById('staffBox') // null với nhân viên (không có form cấp TK nhân viên)
        var customerBox = document.getElementById('customerBox')
        var customerSelect = document.getElementById('customerSelect')
        var newFields = document.getElementById('newCustomerFields')

        function sync() {
          var isCustomer = role.value === 'customer'
          if (staffBox) staffBox.style.display = isCustomer ? 'none' : ''
          customerBox.style.display = isCustomer ? '' : 'none'
          // Chọn hồ sơ có sẵn thì không cần nhập thông tin hồ sơ mới
          newFields.style.display = customerSelect.value ? 'none' : ''
        }

        role.addEventListener('change', sync)
        customerSelect.addEventListener('change', sync)
        sync()
      })()
