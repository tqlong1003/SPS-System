doctype html
html
  head
    title Cấp tài khoản | SPS System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi



        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .form-container-card(style="max-width: 500px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);")
          h2(style="margin-bottom: 20px; color: var(--text-dark); display: flex; align-items: center; gap: 10px;") 
            i.fas.fa-user-plus(style="color: var(--primary);")
            | Cấp tài khoản mới
          
          if error
            p(style="color: #ef4444; background: #fee2e2; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-size: 0.9rem;")
              i.fas.fa-exclamation-circle(style="margin-right: 5px")
              | #{error}
          
          form(method="POST" action="/register")
            .form-group(style="margin-bottom: 15px;")
              label(style="display: block; margin-bottom: 5px; font-weight: 600;") Tên đăng nhập nhân viên
              input(name="username" placeholder="Nhập tên đăng nhập" required minlength="3" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px;")
            .form-group(style="margin-bottom: 15px;")
              label(style="display: block; margin-bottom: 5px; font-weight: 600;") Mật khẩu mặc định
              input(type="password" name="password" placeholder="Tối thiểu 6 ký tự" required minlength="6" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px;")
            button(type="submit" style="width: 100%; padding: 12px; background: var(--bg-gradient); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 700; margin-top: 10px;")
              i.fas.fa-plus-circle(style="margin-right: 8px;")
              | Tạo tài khoản ngay

              // Script xử lý đóng/mở mượt mà cho Dropdown Menu
    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          // Đóng các menu khác
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if (icon) icon.classList.remove('rotate');
            }
          });

          // Bật/tắt menu hiện tại
          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });