doctype html
html
  head
    title Bảng lương - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        // --- TỔNG QUAN ---
        .menu-group
          //- BỎ class .active để menu ở trạng thái đóng mặc định
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-th-large
              span Tổng quan
            i.fas.fa-chevron-down.toggle-icon
          //- BỎ class .show để submenu ẩn đi lúc ban đầu
          .submenu
            a.submenu-item(href="/dashboard") Thống kê
            a.submenu-item(href="/employees") #{user.role === 'admin' ? 'Danh sách nhân viên' : 'Thông tin cá nhân'}

        // --- NHÂN VIÊN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-users
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/attendance") Chấm công
            a.submenu-item(href="/contracts") Hợp đồng
            if user.role === 'admin'
              a.submenu-item(href="/departments") Phòng ban
              a.submenu-item(href="/positions") Chức vụ
              a.submenu-item(href="/employees/add") Thêm mới nhân viên
              a.submenu-item(href="/employees") Danh sách nhân viên
            else
              a.submenu-item(href="/employees") Thông tin cá nhân

        // --- QUẢN LÝ LƯƠNG ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-file-invoice-dollar
              span Quản lý lương
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            if user.role === 'admin'
              a.submenu-item(href="/salary") Tính lương
              a.submenu-item(href="/salary/provisional") Lương tạm tính 🌟
            else
              a.submenu-item(href="/salary") Phiếu lương của tôi



        // --- KHEN THƯỞNG - KỶ LUẬT ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-award
              span Khen thưởng - Kỷ luật
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="#") Khen thưởng
            a.submenu-item(href="#") Kỷ luật

        // --- TÀI KHOẢN ---
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-cog
              span Tài khoản
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/profile") Thông tin tài khoản
            if user.role === 'admin'
              a.submenu-item(href="/accounts") Danh sách tài khoản
              a.submenu-item(href="/register") Tạo tài khoản
            a.submenu-item(href="/change-password") Đổi mật khẩu
            a.submenu-item(href="/logout") Đăng xuất


    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm nhanh...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          if user.role === 'admin'
            h1 💰 Quản lý &amp; Tra cứu tính lương
            p Nhập mã định danh nhân viên tự nhập (ví dụ: NV001) để tiến hành thực hiện chức năng tính lương.
          else
            h1 💰 Lịch sử lương của bạn
            p Tra cứu toàn bộ thông tin lịch sử nhận lương cá nhân trực tuyến.

        // ================= KHU VỰC TRA CỨU ĐỦ ĐIỀU KIỆN (ADMIN) =================
        if user.role === 'admin'
          .stats-grid(style="margin-bottom: 25px;")
            .stat-card(style="width: 100%; display: block; padding: 25px;")
              h3(style="margin-bottom: 15px; color: var(--primary);") 
                i.fas.fa-search-dollar(style="margin-right: 8px;")
                | Tra cứu nhân viên theo mã nhân viên
              
              form(method="GET" action="/salary" style="display: flex; gap: 15px; max-width: 100%; padding: 0; background: transparent; box-shadow: none; border: none; margin: 0;")
                div(style="flex: 1;")
                  label(style="font-size: 0.85rem; font-weight: bold; color: #4b5563;") Chọn tháng lương
                  input(type="month" name="month" value=currentMonth style="margin-top: 5px;")
                div(style="flex: 2;")
                  label(style="font-size: 0.85rem; font-weight: bold; color: #4b5563;") Nhập Mã Nhân Viên
                  input(type="text" name="employeeId" value=searchEmpId placeholder="Nhập mã nhân viên tự quy định (Ví dụ: NV001, NV002...)" style="margin-top: 5px;")
                div(style="display: flex; align-items: flex-end; gap: 10px;")
                  button.btn-add(type="submit" style="margin: 0; padding: 0 25px; height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap; box-sizing: border-box; font-weight: 500; border-radius: 6px;")
                    i.fas.fa-filter
                    | Tìm kiếm
                  if searchEmpId
                    a.btn-cancel(href="/salary" style="margin: 0; padding: 0 20px; height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap; box-sizing: border-box; font-weight: 500; border-radius: 6px; text-decoration: none;")
                      i.fas.fa-undo
                      | Xóa

          // Hiển thị thông báo lỗi nếu không tìm thấy mã
          if errorMsg
            div(style="background-color: #fee2e2; border-left: 4px solid #ef4444; color: #b91c1c; padding: 15px; border-radius: 8px; margin-bottom: 25px; font-weight: 500;")
              |= errorMsg

          // Nếu tìm kiếm thành công theo mã tự nhập, hiển thị thông tin khớp được
          if searchedEmployee
            - const employeeSummary = searchedEmployeeSummary || { name: searchedEmployee.name || 'Chưa cập nhật', employeeCode: searchedEmployee.employeeCode || searchedEmployee.code || searchedEmployee.maNV || 'Chưa xếp mã', basicSalary: Number(searchedEmployee.basicSalary || 0), role: searchedEmployee.role || 'Chưa cập nhật', attendanceDays: 0 }
            .stats-grid(style="margin-bottom: 25px;")
              .stat-card
                .stat-icon.blue(style="background: #6366f1;")
                  i.fas.fa-id-card
                .stat-info
                  span Nhân sự được tìm thấy
                  h2(style="font-size: 1.25rem; margin-top: 5px;") #{employeeSummary.name}
                  p(style="font-size: 0.95rem; color:#374151; margin-top:8px; display: flex; flex-wrap: wrap; gap: 14px;")
                    
                div(style="margin-left: auto;")
                  a.btn-edit(href=`/salary/manage/${searchedEmployee._id}?month=${currentMonth}` style="padding: 10px 20px; display: inline-flex; align-items: center; gap: 8px; border-radius: 8px; background: #10b981; text-decoration: none;")
                    i.fas.fa-calculator
                    | Thực hiện tính toán lương

        // ================= CHI TIẾT BẢNG LƯƠNG HIỂN THỊ =================
        h2(style="margin: 20px 0; font-size: 1.4rem; display: flex; align-items: center; gap: 10px;")
          if user.role === 'admin'
            i.fas.fa-list-alt(style="color: var(--primary);")
            | Kết quả bảng tính lương tháng #{currentMonth}
          else
            i.fas.fa-history(style="color: var(--primary);")
            | Toàn bộ lịch sử lương cá nhân

        .table-container
          table
            thead
              tr
                th Tháng
                th Tên nhân viên
                th Mã nhân viên
                th Lương cơ bản (VND)
                th Chức vụ
                th Số công thực tế
                th Thưởng &amp; Phụ cấp
                th Tạm ứng
                th Thực nhận thực tế
            tbody
              if salaries && salaries.length > 0
                each s in salaries
                  tr
                    td= s.month
                    td(style="font-weight: bold;")= s.employeeName
                    td= s.employeeCode || s.employee || 'Chưa cập nhật'
                    td= Number(s.baseSalary || 0).toLocaleString('vi-VN') + ' đ'
                    td= s.role || 'Chưa cập nhật'
                    td= s.attendanceDays != null ? s.attendanceDays : 'Chưa cập nhật'
                    td= (Number(s.bonus || 0) + Number(s.allowance || 0) + Number(s.raise || 0)).toLocaleString('vi-VN') + ' đ'
                    td(style="color: var(--danger); font-weight: 500;")= '-' + Number(s.advance || 0).toLocaleString('vi-VN') + ' đ'
                    td(style="font-weight: bold; color: var(--success);")= Number(s.finalSalary || 0).toLocaleString('vi-VN') + ' đ'
              else
                tr
                  td(colspan="9" style="text-align: center; padding: 40px; color: #6b7280; font-style: italic;")
                    if user.role === 'admin'
                      if searchEmpId
                        | Nhân viên này chưa được khởi tạo cấu trúc tính lương trong tháng #{currentMonth}.
                      else
                        | Không có dữ liệu tính toán lương tổng hợp nào cho tháng này.
                    else
                      | Hệ thống chưa cập nhật dữ liệu lịch sử phiếu lương của bạn.

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });