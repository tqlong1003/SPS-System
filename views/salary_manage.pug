doctype html
html
  head
    title HRM System - Quản lý thu nhập
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar đồng bộ
    nav.sidebar
      .sidebar-header
        i.fas.fa-bolt
        span SPS System
      
      .sidebar-menu
        p.menu-label CHÍNH
        a.menu-item(href="/dashboard")
          i.fas.fa-th-large
          span Tổng quan
        
        p.menu-label NHÂN SỰ
        a.menu-item(href="/employees")
          i.fas.fa-users
          span Nhân viên
        a.menu-item(href="/departments")
          i.fas.fa-sitemap
          span Phòng ban
        a.menu-item(href="/positions")
          i.fas.fa-briefcase
          span Chức vụ
        a.menu-item(href="/attendance")
          i.fas.fa-calendar-check
          span Chấm công
        a.menu-item(href="/contracts")
          i.fas.fa-file-contract
          span Hợp đồng


        p.menu-label TÀI CHÍNH
        a.menu-item.active(href="/salary")
          i.fas.fa-file-invoice-dollar
          span #{user.role === 'admin' ? 'Quản lý lương' : 'Phiếu lương'}
      
      .sidebar-footer
        a.logout-btn(href="/logout")
          i.fas.fa-sign-out-alt
          span Đăng xuất

    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 ⚙️ Thiết lập lương
          p Đang xử lý bảng lương cho nhân viên: 
            strong #{emp.name}

        .center-wrapper
          .card-form
            .card-header
              i.fas.fa-calculator
              h2 Chi tiết thu nhập
            
            form(method="POST")
              .form-group
                label Tháng trả lương
                input(type="month", name="month", required, value=new Date().toISOString().slice(0, 7))
              
              .form-group
                label Lương cơ bản (VNĐ)
                input(type="number", name="baseSalary", placeholder="Ví dụ: 10000000", required)
              
              .form-group
                label Thưởng
                input(type="number", name="bonus", value="0")
              
              .form-group
                label Phụ cấp
                input(type="number", name="allowance", value="0")
              
              .form-group
                label Tăng lương bổ sung
                input(type="number", name="raise", value="0")
              
              .form-group
                label Tạm ứng lương
                input(type="number", name="advance", value="0")
              
              .form-actions
                button.btn-save(type="submit") 
                  i.fas.fa-check-circle
                  |  Cập nhật lương
                a.btn-cancel(href="/salary") Hủy bỏ