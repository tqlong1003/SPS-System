doctype html
html
  head
    title Thiết lập lương - HRM System
    link(rel="stylesheet", href="/public/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body.dashboard-body
    // Sidebar bên trái
    include sidebar.pug

    // Khu vực nội dung bên phải
    main.main-content
      header.topbar
        .search-bar
          i.fas.fa-search
          input(type="text" placeholder="Tìm kiếm...")
        .user-info
          span.welcome Xin chào, 
            strong #{user.username}
          .avatar #{user.username.charAt(0).toUpperCase()}

      .content-wrapper
        .welcome-banner
          h1 ⚙️ Thiết lập lương
          p Đang xử lý bảng lương cho nhân viên: 
            strong #{emp ? emp.name : ""}

        .table-container(style="margin-bottom: 24px;")
          table
            thead
              tr
                th Tháng
                th Tên nhân viên
                th Mã nhân viên
                th Lương cơ bản (VND)
                th Chức vụ
                th Số công thực tế
            tbody
              - const summary = salarySummary || { month: salaryMonth || new Date().toISOString().slice(0, 7), name: emp?.name || 'Chưa cập nhật', employeeCode: emp?.employeeCode || emp?.code || emp?.maNV || 'Chưa xếp mã', baseSalary: Number(emp?.basicSalary || 0), role: emp?.role || 'Chưa cập nhật', attendanceDays: 0 }
              tr
                td= summary.month
                td(style="font-weight: bold;")= summary.name
                td= summary.employeeCode
                td= summary.baseSalary.toLocaleString('vi-VN') + ' đ'
                td= summary.role
                td= summary.attendanceDays

        .center-wrapper
          .card-form
            .card-header
              i.fas.fa-calculator
              h2 Chi tiết thu nhập
            
            form(method="POST")
              .form-group
                label Tháng trả lương
                input(type="month", name="month", required, value=salaryMonth)

              .form-group
                label Công chuẩn tháng
                input(type="number", value=summary.standardWorkDays || 26, readonly, style="background-color: #f3f4f6; color: #6b7280; cursor: not-allowed; font-weight: bold;")

              .form-group 
                label Tên nhân viên
                input(type="text", name="employeeName", value=emp ? emp.name : "", readonly, style="background-color: #f3f4f6; color: #6b7280; cursor: not-allowed; font-weight: bold;")  

              .form-group
                label Mã nhân viên
                input(type="text", name="employeeCode", value=emp ? emp.employeeCode || emp.code || emp.maNV : "", readonly, style="background-color: #f3f4f6; color: #6b7280; cursor: not-allowed; font-weight: bold;")

              .form-group
                label Chức vụ
                input(type="text", name="role", value=emp ? emp.role : "", readonly, style="background-color: #f3f4f6; color: #6b7280; cursor: not-allowed; font-weight: bold;")
              
              .form-group
                label Lương cơ bản (VNĐ) (Tự động lấy từ hồ sơ)
                input(type="number", name="baseSalary", value=(emp.basicSalary || 0), readonly, style="background-color: #f3f4f6; color: #6b7280; cursor: not-allowed; font-weight: bold;")
              
              .form-group 
                label Số công thực tế (tự động cập nhật từ dữ liệu chấm công)
                input(type="number", name="attendanceDays", value=summary.attendanceDays || 0, readonly, style="background-color: #f3f4f6; color: #6b7280; cursor: not-allowed; font-weight: bold;")

              .form-group
                label Thưởng
                input(type="number", name="bonus", value="0")
              
              .form-group
                label Tạm ứng lương
                input(type="number", name="advance", value="0")

              p(style="margin-top: 12px; color: #4b5563; font-size: 0.95rem; line-height: 1.5;")
                | Công thức áp dụng: (Lương cơ bản / công chuẩn) x số công + thưởng - tạm ứng
              
              .form-actions
                button.btn-save(type="submit") 
                  i.fas.fa-check-circle
                  | Cập nhật lương
                a.btn-cancel(href="/salary" style="margin-left: 10px; text-decoration: none;") Hủy bỏ

    script.
      document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          const menuGroup = this.closest('.menu-group');
          const submenu = menuGroup.querySelector('.submenu');
          const toggleIcon = this.querySelector('.toggle-icon');
          
          document.querySelectorAll('.submenu').forEach(sub => {
            if (sub !== submenu) {
              sub.classList.remove('show');
              const icon = sub.closest('.menu-group').querySelector('.toggle-icon');
              if(icon) icon.classList.remove('rotate');
            }
          });

          submenu.classList.toggle('show');
          toggleIcon.classList.toggle('rotate');
        });
      });