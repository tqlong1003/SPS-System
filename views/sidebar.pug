nav.sidebar
  .sidebar-header
    i.fas.fa-mobile-screen-button
    span PhoneShop CRM

  .sidebar-menu
    if user.role === 'customer'
      // --- KHÁCH HÀNG: CỔNG KHÁCH HÀNG ---
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-house
            span Trang chủ
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/dashboard") Tổng quan của tôi

      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-mobile-alt
            span Cửa hàng
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/products") Sản phẩm đang bán

      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-receipt
            span Của tôi
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/my/orders") Đơn hàng của tôi
          a.submenu-item(href="/my/warranties") Bảo hành của tôi
          a.submenu-item(href="/my/announcements")
            | Thông báo
            if unreadAnnouncementCount
              span(style="margin-left:8px; background:#dc2626; color:white; padding:1px 8px; border-radius:10px; font-size:0.75em; font-weight:600;")= unreadAnnouncementCount
          a.submenu-item(href="/my/complaints") Khiếu nại của tôi

      //- Nhân viên chăm sóc: hiển thị thông tin nhân viên phụ trách ngay trong menu (biến supportStaff do server nạp)
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-headset
            span Nhân viên chăm sóc
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          //- Chỉ hiển thị để khách xem: không liên kết, không bấm được (pointer-events: none)
          if supportStaff
            div.submenu-item(style="pointer-events: none; cursor: default; word-break: break-word;")= 'Tên: ' + supportStaff.name
            div.submenu-item(style="pointer-events: none; cursor: default; word-break: break-word;")= 'Mã NV: ' + (supportStaff.employeeCode || 'Chưa có')
            div.submenu-item(style="pointer-events: none; cursor: default; word-break: break-word;")= 'SĐT: ' + (supportStaff.phone || 'Chưa có')
            div.submenu-item(style="pointer-events: none; cursor: default; word-break: break-word;")= 'Email: ' + (supportStaff.email || 'Chưa có')
          else
            div.submenu-item(style="pointer-events: none; cursor: default;") Chưa được phân công

      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-user-cog
            span Tài khoản
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/profile") Thông tin của tôi
          a.submenu-item(href="/profile/edit") Cập nhật thông tin
          a.submenu-item(href="/change-password") Đổi mật khẩu
          a.submenu-item(href="/logout") Đăng xuất
    else
      // --- TỔNG QUAN ---
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-th-large
            span Tổng quan
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/dashboard") Thống kê

      // --- KHÁCH HÀNG ---
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-address-book
            span Khách hàng
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/customers") Danh sách khách hàng
          a.submenu-item(href="/customers/add") Thêm khách hàng
          a.submenu-item(href="/customers?filter=birthday") 🎂 Sinh nhật tháng này
          a.submenu-item(href="/reminders") Nhắc lịch chăm sóc
          a.submenu-item(href="/complaints") Khiếu nại khách hàng
          a.submenu-item(href="/announcements") Thông báo khách hàng

      // --- SẢN PHẨM / KHO ---
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-mobile-alt
            span Sản phẩm & Kho
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/products") Danh sách sản phẩm
          if user.role === 'admin'
            a.submenu-item(href="/products/add") Thêm sản phẩm
          a.submenu-item(href="/products?filter=lowstock") Sản phẩm sắp hết hàng


      // --- NHÂN VIÊN ---
      if user.role === 'admin'
        .menu-group
          a.menu-item.has-submenu(href="#")
            span
              i.fas.fa-user-tie
              span Nhân viên
            i.fas.fa-chevron-down.toggle-icon
          .submenu
            a.submenu-item(href="/employees") Danh sách nhân viên


      // --- BÁN HÀNG ---
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-cash-register
            span Đơn Hàng
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/orders") Đơn hàng bán
          a.submenu-item(href="/orders/add") Tạo đơn hàng
          a.submenu-item(href="/warranties") Phiếu bảo hành


      // --- TÀI KHOẢN ---
      .menu-group
        a.menu-item.has-submenu(href="#")
          span
            i.fas.fa-user-cog
            span Tài khoản
          i.fas.fa-chevron-down.toggle-icon
        .submenu
          a.submenu-item(href="/profile") Thông tin tài khoản
          a.submenu-item(href="/change-password") Đổi mật khẩu
          if user.role === 'admin'
            a.submenu-item(href="/accounts") Tài khoản nội bộ
            
          a.submenu-item(href="/register")= user.role === 'admin' ? 'Cấp tài khoản mới' : 'Cấp tài khoản cho khách hàng'
          a.submenu-item(href="/logout") Đăng xuất
